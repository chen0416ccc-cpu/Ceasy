        <Style x:Key="RailNavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RailButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="RailButtonScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <!-- The rail is where a click most often costs something -
                                                 it changes route - so its press feedback has to land
                                                 before the route transition starts, not alongside it.
                                                 One shared 0.14s transition used to cover press as
                                                 well, which put the 8% squeeze behind the navigation. -->
                                            <VisualTransition To="Pressed" GeneratedDuration="0:0:0.07">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                            <VisualTransition From="Pressed" GeneratedDuration="0:0:0.13">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                            <VisualTransition GeneratedDuration="0:0:0.11">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RailHoverFill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.06"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="RailHoverFill"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.11"
                                                                 Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="RailButtonScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.92"
                                                                 Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="RailButtonScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.92"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <!-- The hover state is a Double on its own layer so the VisualTransition
                                     GeneratedDuration above has something to interpolate. The earlier empty
                                     ColorAnimation faded nothing: the colour came from style setters through
                                     TemplateBinding, and those swap the whole brush reference at once.
                                     A neutral ink veil is used rather than a tinted fill so it also reads
                                     correctly on the selected button, whose own PrimarySoftBrush background
                                     stays visible underneath. -->
                                <Border x:Name="RailHoverFill"
                                        Background="{DynamicResource InkBrush}"
                                        CornerRadius="6"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Hover fill and outline moved into RailHoverFill so the change can fade in. Setting
                     Background or BorderBrush here would also fight the selected button, which expresses
                     selection through those very properties. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

