                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Border Grid.Column="3"
                                                                    Background="{DynamicResource BorderStrongBrush}" />

                                                            <StackPanel Grid.Column="4"
                                                                        Margin="14,0"
                                                                        AutomationProperties.AutomationId="WorkflowThenGroup">
                                                                <TextBlock Text="{Binding [Workflow.Then], Source={StaticResource Loc}}"
                                                                           Margin="0,0,0,8"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource InkMutedBrush}" />
                                                                <Border Padding="9,7"
                                                                        Background="{DynamicResource PrimarySoftBrush}"
                                                                        CornerRadius="7">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE724;"
                                                                                   Margin="0,0,7,0"
                                                                                   VerticalAlignment="Center"
                                                                                   FontFamily="{StaticResource IconFont}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource PrimaryBrush}" />
                                                                        <TextBlock Text="{Binding [Workflow.SendThisPreset], Source={StaticResource Loc}}"
                                                                                   VerticalAlignment="Center"
                                                                                   FontSize="11"
                                                                                   FontWeight="SemiBold" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Grid Margin="0,9,0,0">
                                                                    <Grid.Style>
                                                                        <Style TargetType="Grid">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UseWorkflowAutomation}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Grid.Style>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding [Workflow.EnableProtection], Source={StaticResource Loc}}"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                                               FontSize="11" />
                                                                    <CheckBox Grid.Column="1"
                                                                              AutomationProperties.AutomationId="WorkflowEnableProtectionToggle"
                                                                              AutomationProperties.Name="{Binding [Workflow.EnableProtection], Source={StaticResource Loc}}"
                                                                              IsChecked="{Binding WorkflowEnableTargetProtection, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"
                                                                              Style="{StaticResource ToggleCheckStyle}" />
                                                                </Grid>
                                                                <Grid Margin="0,10,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="8" />
                                                                        <ColumnDefinition Width="70" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="7" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding [FollowUp.MaximumErrorRetries], Source={StaticResource Loc}}"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                                               FontSize="10" />
                                                                    <TextBox Grid.Column="2"
                                                                             AutomationProperties.AutomationId="FollowUpMaximumErrorRetriesTextBox"
                                                                             AutomationProperties.Name="{Binding [FollowUp.MaximumErrorRetries], Source={StaticResource Loc}}"
                                                                             Text="{Binding MaximumErrorRetriesText, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                                                                             IsEnabled="{Binding IsFiniteRetry}"
                                                                             Height="32"
                                                                             MaxLength="5"
                                                                             Padding="8,0"
                                                                             TextAlignment="Center"
                                                                             FocusVisualStyle="{x:Null}"
                                                                             Style="{StaticResource FieldTextBoxStyle}"
                                                                             ToolTip="{Binding [FollowUp.RetryDefaultHint], Source={StaticResource Loc}}" />
                                                                    <TextBlock Grid.Column="4"
                                                                               Text="{Binding [FollowUp.RetryInfinite], Source={StaticResource Loc}}"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                                               FontSize="10" />
                                                                    <CheckBox Grid.Column="6"
                                                                              AutomationProperties.AutomationId="FollowUpRetryIndefinitelyToggle"
                                                                              AutomationProperties.Name="{Binding [FollowUp.RetryInfinite], Source={StaticResource Loc}}"
                                                                              IsChecked="{Binding RetryIndefinitely, Mode=TwoWay}"
                                                                              VerticalAlignment="Center"
                                                                              Style="{StaticResource ToggleCheckStyle}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Grid>

                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="FollowUpEmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0">
                        <StackPanel.RenderTransform>
                            <TranslateTransform />
                        </StackPanel.RenderTransform>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FollowUpMessages.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="&#xE8F2;"
                                   HorizontalAlignment="Center"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="22"
                                   Foreground="{DynamicResource InkSubtleBrush}" />
                        <TextBlock AutomationProperties.AutomationId="FollowUpDraftEmptyHint"
                                   Text="{Binding [FollowUp.EmptyHint], Source={StaticResource Loc}}"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Activity -->
            <Grid x:Name="ActivityPageRoot"
                  Margin="16,0,16,16"
                  Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverviewPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid x:Name="ActivityHeaderStage"
                      Margin="4,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding [Shell.Activity], Source={StaticResource Loc}}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <Border
                             VerticalAlignment="Bottom"
                             Height="1"
                             Background="{DynamicResource BorderBrush}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="ActivityStreamStage">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding [Activity.SystemEvents], Source={StaticResource Loc}}"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="ClearActivityEventsButton"
                                    AutomationProperties.Name="{Binding [Activity.ClearEvents], Source={StaticResource Loc}}"
                                    Command="{Binding ClearEventsCommand}"
                                    ToolTip="{Binding [Activity.ClearEvents], Source={StaticResource Loc}}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Events.Count}" Value="0">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="&#xE74D;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="13" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="1"
                                Style="{StaticResource SurfaceStyle}"
                                Padding="4">
                            <Grid>
                                <ListBox x:Name="ActivityList"
                                         AutomationProperties.AutomationId="ActivityEventList"
                                         AutomationProperties.Name="{Binding [Activity.SystemEvents], Source={StaticResource Loc}}"
                                         ItemsSource="{Binding Events}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource FlatListItemStyle}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="58"
                                                  Margin="8,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="62" />
                                                    <ColumnDefinition Width="68" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MonoTextStyle}" />
                                                <Border Grid.Column="1"
                                                        Width="54"
                                                        Height="22"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4">
                                                    <TextBlock Text="{Binding Level}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Success}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Warning}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static models:LogLevel.Error}">
                                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Message}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding ThreadName}"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               FontSize="10"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Events.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE9D9;"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="22"
                                               Foreground="{DynamicResource InkSubtleBrush}" />
                                    <TextBlock Text="{Binding [Overview.NoActivity], Source={StaticResource Loc}}"
                                               Margin="0,10,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="ActivityLineageStage"
                          Grid.Column="2"
                          AutomationProperties.AutomationId="WorkflowLineageRegion"
                          AutomationProperties.Name="{Binding [Activity.WorkflowLineage], Source={StaticResource Loc}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding [Activity.WorkflowLineage], Source={StaticResource Loc}}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="WorkflowLineageStatus"
                                           AutomationProperties.AutomationId="WorkflowLineageStatus"
                                           AutomationProperties.Name="{Binding WorkflowLineageStatusText}"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding WorkflowLineageStatusText}"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           FontSize="10" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    AutomationProperties.AutomationId="RefreshWorkflowLineageButton"
                                    AutomationProperties.Name="{Binding [Activity.RefreshLineage], Source={StaticResource Loc}}"
                                    Command="{Binding RefreshWorkflowLineageCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="{Binding [Activity.RefreshLineage], Source={StaticResource Loc}}">
                                <TextBlock Text="&#xE72C;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="13" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="1"
                                Style="{StaticResource SurfaceStyle}"
                                Padding="6,4">
                            <Grid>
                                <ListBox x:Name="WorkflowLineageList"
                                         AutomationProperties.AutomationId="WorkflowLineageEntryList"
                                         AutomationProperties.Name="{Binding [Activity.WorkflowLineage], Source={StaticResource Loc}}"
                                         ItemsSource="{Binding WorkflowLineageItems}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem"
                                               BasedOn="{StaticResource FlatListItemStyle}">
                                            <Setter Property="AutomationProperties.AutomationId"
                                                    Value="{Binding AutomationId}" />
                                            <Setter Property="AutomationProperties.Name"
                                                    Value="{Binding AutomationName}" />
                                            <Setter Property="AutomationProperties.ItemStatus"
                                                    Value="{Binding StateText}" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="5,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Height="24">
                                                    <Grid.Style>
                                                        <Style TargetType="Grid">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCorrelationStart}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Grid.Style>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding CorrelationText}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource InkSubtleBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                    <Border Grid.Column="1"
                                                            Height="1"
                                                            Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource BorderBrush}" />
                                                </Grid>
                                                <Grid Grid.Row="1" MinHeight="86">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="{Binding IndentWidth}" />
                                                    <Border Grid.Column="1"
                                                            Width="2"
                                                            HorizontalAlignment="Center"
                                                            Background="{DynamicResource BorderStrongBrush}" />
                                                    <Ellipse Grid.Column="1"
                                                             Width="7"
                                                             Height="7"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Top"
                                                             Margin="0,17,0,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource InkSubtleBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:WorkflowLineageTone.Active}">
                                                                        <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:WorkflowLineageTone.Success}">
                                                                        <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:WorkflowLineageTone.Warning}">
                                                                        <Setter Property="Fill" Value="{DynamicResource OrangeBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:WorkflowLineageTone.Danger}">
                                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <Grid Grid.Column="2" Margin="4,9,4,9">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding KindText}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1"
                                                                    Margin="8,0,0,0"
                                                                    Padding="6,2"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource ControlSurfaceBrush}"
                                                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5">
                                                                <TextBlock Text="{Binding StateText}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:WorkflowLineageTone.Active}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:WorkflowLineageTone.Success}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:WorkflowLineageTone.Warning}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Tone}" Value="{x:Static models:WorkflowLineageTone.Danger}">
                                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding TimeText}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource MonoTextStyle}" />
                                                        </Grid>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding RouteText}"
                                                                   ToolTip="{Binding RouteText}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding MetaText}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                                   FontSize="10"
                                                                   LineHeight="14"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="3"
                                                                   Text="{Binding FailureText}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource OrangeBrush}"
                                                                   FontSize="10"
                                                                   LineHeight="14"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding FailureText}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Row="4"
                                                                   Text="{Binding NextActionText}"
                                                                   Margin="0,3,0,0"
                                                                   Foreground="{DynamicResource InkSubtleBrush}"
                                                                   FontSize="10"
                                                                   LineHeight="14"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                    <Border Grid.Column="2"
                                                            Height="1"
                                                            VerticalAlignment="Bottom"
                                                            Background="{DynamicResource BorderBrush}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasWorkflowLineageItems}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="&#xE81C;"
                                               HorizontalAlignment="Center"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="21"
                                               Foreground="{DynamicResource InkSubtleBrush}" />
                                    <TextBlock Text="{Binding WorkflowLineageEmptyText}"
                                               Margin="0,9,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Guardrails -->
            <Grid x:Name="GuardrailsPageRoot"
                  Margin="16,0,16,16"
                  Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecoveryPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="GuardrailsHeaderStage"
                            Margin="4,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Shell.Guardrails], Source={StaticResource Loc}}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Border VerticalAlignment="Bottom"
                        Height="1"
                        Margin="4,0"
                        Background="{DynamicResource BorderBrush}" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="4,20,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="GuardrailsLeftColumn"
                                    Margin="0,0,28,0">
                            <!-- The master switch for automatic protection used to head this column. It
                                 now lives in the title bar, where it is reachable from every page, and a
                                 second copy here would be the same switch in two places: whichever one
                                 the user last touched would be the one they trust, and the other would
                                 look like it had been ignored. What is left on this page is the detail
                                 the switch does not cover. -->
                            <Grid x:Name="GuardrailsChannelStage">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Recovery.DesktopChannelTitle], Source={StaticResource Loc}}"
                                               Style="{StaticResource SectionHeaderStyle}" />
                                    <TextBlock Text="{Binding DesktopChannelText}"
                                               Margin="0,5,0,0"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Command="{Binding ProbeDesktopChannelCommand}"
                                            AutomationProperties.Name="{Binding [Action.RecheckDesktopChannel], Source={StaticResource Loc}}"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="{Binding [Action.RecheckDesktopChannel], Source={StaticResource Loc}}">
                                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                    <Button Command="{Binding RunReadOnlyDiagnosticCommand}"
                                            AutomationProperties.Name="{Binding [Action.ReadOnlyDiagnostic], Source={StaticResource Loc}}"
                                            Margin="6,0,0,0"
                                            Style="{StaticResource IconButtonStyle}"
                                            ToolTip="{Binding [Action.ReadOnlyDiagnostic], Source={StaticResource Loc}}">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,20,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0" />

                            <!-- Both backoff values were settable in the model and saved on change, with no
                                 way to see or set them. The pair is shown together because they constrain
                                 each other: raising the initial value pushes the ceiling up with it. -->
                            <TextBlock Text="{Binding [Policy.BackoffTitle], Source={StaticResource Loc}}"
                                       Margin="0,18,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{Binding [Policy.BackoffHint], Source={StaticResource Loc}}"
                                       Margin="0,5,0,0"
                                       Style="{StaticResource FieldHintStyle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [Policy.InitialBackoff], Source={StaticResource Loc}}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.AutomationId="InitialBackoffInput"
                                                 AutomationProperties.Name="{Binding [Policy.InitialBackoff], Source={StaticResource Loc}}"
                                                 Style="{StaticResource FieldTextBoxStyle}"
                                                 Text="{Binding BaseBackoffSeconds, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{Binding [Policy.InitialBackoffHint], Source={StaticResource Loc}}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding [Policy.SecondsUnit], Source={StaticResource Loc}}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   FontSize="11" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [Policy.MaximumBackoff], Source={StaticResource Loc}}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.AutomationId="MaximumBackoffInput"
                                                 AutomationProperties.Name="{Binding [Policy.MaximumBackoff], Source={StaticResource Loc}}"
                                                 Style="{StaticResource FieldTextBoxStyle}"
                                                 Text="{Binding MaximumBackoffSeconds, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="{Binding [Policy.MaximumBackoffHint], Source={StaticResource Loc}}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding [Policy.SecondsUnit], Source={StaticResource Loc}}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Border Margin="0,20,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0" />

                            <TextBlock Text="{Binding [Policy.NewThreadTitle], Source={StaticResource Loc}}"
                                       Margin="0,18,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Settings.ProtectNewThreadsByDefault], Source={StaticResource Loc}}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <CheckBox Grid.Column="1"
                                          AutomationProperties.AutomationId="ProtectNewThreadsSwitch"
                                          AutomationProperties.Name="{Binding [Settings.ProtectNewThreadsByDefault], Source={StaticResource Loc}}"
                                          IsChecked="{Binding ProtectNewThreadsByDefault, Mode=TwoWay}"
                                          Style="{StaticResource ToggleCheckStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding [Policy.ProtectNewThreadsHint], Source={StaticResource Loc}}"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource FieldHintStyle}" />
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource BorderBrush}" />

                        <StackPanel x:Name="GuardrailsContinuationStage"
                                    Grid.Column="2"
                                    Margin="28,0,0,0">
                            <TextBlock Text="{Binding [Recovery.ContinueMessageTitle], Source={StaticResource Loc}}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBox Text="{Binding ContinueMessage, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding [Recovery.ContinueMessageTitle], Source={StaticResource Loc}}"
                                     Margin="0,12,0,0"
                                     MaxLength="4000"
                                     Style="{StaticResource FieldTextBoxStyle}"
                                     ToolTip="{Binding [Recovery.ContinueMessageHint], Source={StaticResource Loc}}" />

                            <TextBlock Text="{Binding [Policy.MaximumAttempts], Source={StaticResource Loc}}"
                                       Margin="0,20,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding MaximumAttempts, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsFiniteRecoveryAttempts}"
                                         AutomationProperties.Name="{Binding [Policy.MaximumAttempts], Source={StaticResource Loc}}"
                                         Style="{StaticResource FieldTextBoxStyle}" />
                                <CheckBox Grid.Column="1"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="{Binding [Policy.UnlimitedAttempts], Source={StaticResource Loc}}"
                                          IsChecked="{Binding UnlimitedRecoveryAttempts, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding [Policy.UnlimitedAttempts], Source={StaticResource Loc}}"
                                          Style="{StaticResource ToggleCheckStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding [Policy.CountingMode], Source={StaticResource Loc}}"
                                       Margin="0,16,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <ComboBox Margin="0,10,0,0"
                                      ItemsSource="{Binding RecoveryCountingModeOptions}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Mode"
                                      SelectedValue="{Binding RecoveryCountingMode, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding [Policy.CountingMode], Source={StaticResource Loc}}"
                                      Style="{StaticResource FieldComboBoxStyle}"
                                      ToolTip="{Binding [Policy.CountingModeHint], Source={StaticResource Loc}}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Keep-alive -->
            <Grid x:Name="KeepAlivePageRoot"
                  Margin="16,0,16,16"
                  Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeepAlivePage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="KeepAliveHeaderStage" Margin="4,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding [KeepAlive.Title], Source={StaticResource Loc}}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding KeepAliveStatusText}"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource InkMutedBrush}"
                               FontSize="11" />
                </StackPanel>
                <!-- Two columns because the conversation list is capped, and on a wide window the cap left
                     the right half of the page empty. The list keeps its cap for the reason below; what
                     changed is that the width it does not want is now spent on the runtime panel rather
                     than on nothing. Both columns are Auto/star so a narrow window collapses the panel
                     to its own minimum and the list keeps the rest. -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Capped and left-aligned rather than stretched. Each row ends in a control, and on a
                         wide window a full-bleed row put the selector a screen's width away from the name it
                         belongs to, so the two stopped reading as one thing. -->
                    <Grid Grid.Column="0"
                          Margin="4,0,4,0"
                          MaxWidth="880"
                          HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search and filter stay pinned while the list scrolls beneath them. The whole
                         point of this page is reaching one named conversation out of a hundred, and a
                         search box that scrolls off the top defeats that. -->
                    <Grid x:Name="KeepAlivePolicyStage" Height="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     Padding="32,0,38,0"
                                     Background="{DynamicResource GlassSurfaceStrongBrush}"
                                     AutomationProperties.AutomationId="KeepAliveSearchBox"
                                     AutomationProperties.Name="{Binding [KeepAlive.SearchPlaceholder], Source={StaticResource Loc}}"
                                     Style="{StaticResource FieldTextBoxStyle}"
                                     Text="{Binding KeepAliveSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="&#xE721;"
                                       Margin="11,0,0,0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkSubtleBrush}"
                                       IsHitTestVisible="False" />
                            <TextBlock Margin="32,0,38,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding [KeepAlive.SearchPlaceholder], Source={StaticResource Loc}}"
                                       Foreground="{DynamicResource InkSubtleBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasKeepAliveSearchText}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ToggleButton Grid.Column="1"
                                      Tag="&#xE734;"
                                      Margin="10,0,0,0"
                                      Content="{Binding [KeepAlive.HeldOnly], Source={StaticResource Loc}}"
                                      AutomationProperties.AutomationId="KeepAliveHeldOnlyToggle"
                                      IsChecked="{Binding KeepAliveShowHeldOnly, Mode=TwoWay}"
                                      Style="{StaticResource TitleBarSwitchStyle}" />

                        <!-- Interval and message are set once and then left alone, so they sit behind a
                             disclosure instead of taking permanent space above a list the user came here
                             to scan. The drawer's open state lives on the button itself; no view-model
                             field is needed for something that resets with the page. -->
                        <ToggleButton x:Name="KeepAliveSettingsToggle"
                                      Grid.Column="2"
                                      Tag="&#xE713;"
                                      Margin="0"
                                      Content="{Binding [KeepAlive.Settings], Source={StaticResource Loc}}"
                                      AutomationProperties.AutomationId="KeepAliveSettingsToggle"
                                      Style="{StaticResource TitleBarSwitchStyle}" />
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,8,0,0"
                            Background="{DynamicResource GlassSurfaceStrongBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            ClipToBounds="True">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Height" Value="0" />
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=KeepAliveSettingsToggle}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <!-- Visibility is animated rather than set by this
                                                         trigger. Undoing a trigger Setter is instant, so a
                                                         Setter here would drop the drawer back to Collapsed
                                                         on the same frame the toggle clears, and the
                                                         collapse storyboard below would then be animating an
                                                         element that had already left the render pass - the
                                                         expand was smooth and the close snapped. An
                                                         animation outranks the base Setter, holds its end
                                                         value, and is replaced (not undone) by the exit
                                                         storyboard, which is what lets the collapse be seen.
                                                         Collapsed rather than Hidden on the way out so the
                                                         8px top margin stops taking up room too, and so the
                                                         fields inside leave the tab order and the UIA tree
                                                         while the drawer is shut. -->
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static sys:Visibility.Visible}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <!-- Tall enough for the wording box to show the six
                                                         default phrasings at once. The rotation only
                                                         reads as a set if the user can see more than one
                                                         line of it without scrolling a 30px field. -->
                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                     To="138"
                                                                     Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="1"
                                                                     Duration="0:0:0.2" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static sys:Visibility.Visible}" />
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.18" Value="{x:Static sys:Visibility.Collapsed}" />
                                                    </ObjectAnimationUsingKeyFrames>
                                                    <DoubleAnimation Storyboard.TargetProperty="Height"
                                                                     To="0"
                                                                     Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.14" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- Everything but the wording box is a single line and sits at the top; the
                             wording box stretches, because it is the only field here whose content is a
                             list rather than one value. -->
                        <Grid Margin="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- The sentinel, with the conversation it sends into named right beside it.
                                 The destination is set from a row in the list below rather than picked
                                 here: it is one of the conversations already on this page, and a second
                                 list would have to repeat the same grouping to be usable. -->
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,14,0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Top"
                                        Height="30">
                                <ToggleButton Tag="&#xE945;"
                                              Content="{Binding [KeepAlive.SentinelTitle], Source={StaticResource Loc}}"
                                              AutomationProperties.AutomationId="KeepAliveSentinelToggle"
                                              IsChecked="{Binding KeepAliveSentinelEnabled, Mode=TwoWay}"
                                              Style="{StaticResource TitleBarSwitchStyle}"
                                              ToolTip="{Binding [KeepAlive.SentinelHint], Source={StaticResource Loc}}" />
                                <TextBlock Margin="2,0,0,0"
                                           MaxWidth="190"
                                           VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="KeepAliveSentinelDestination"
                                           Text="{Binding KeepAliveSentinelDestinationName}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource InkSubtleBrush}"
                                           FontSize="10.5"
                                           ToolTip="{Binding [KeepAlive.SentinelDestinationTitle], Source={StaticResource Loc}}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Width="1"
                                    Height="30"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource BorderBrush}" />
                            <TextBox Grid.Column="2"
                                     Width="52"
                                     Height="30"
                                     VerticalAlignment="Top"
                                     HorizontalContentAlignment="Center"
                                     MinHeight="30"
                                     AutomationProperties.AutomationId="KeepAliveIntervalBox"
                                     AutomationProperties.Name="{Binding [KeepAlive.IntervalTitle], Source={StaticResource Loc}}"
                                     Style="{StaticResource FieldTextBoxStyle}"
                                     ToolTip="{Binding [KeepAlive.IntervalTitle], Source={StaticResource Loc}}"
                                     Text="{Binding KeepAliveIntervalMinutes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            <TextBlock Grid.Column="3"
                                       Margin="7,0,14,0"
                                       Height="30"
                                       VerticalAlignment="Top"
                                       Padding="0,7,0,0"
                                       Text="{Binding [KeepAlive.IntervalUnit], Source={StaticResource Loc}}"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       FontSize="11" />
                            <!-- Empty is the default and means "generate an arithmetic question each time",
                                 so the box needs a watermark: an empty field with no explanation reads as
                                 broken. A non-empty field is a literal pool, one phrasing per line, which
                                 is why Enter has to reach the box instead of moving focus and wrapping
                                 stays off — a wrapped long line would look like two phrasings. -->
                            <Grid Grid.Column="4">
                                <TextBox x:Name="KeepAliveMessageInput"
                                         MinHeight="30"
                                         VerticalAlignment="Stretch"
                                         VerticalContentAlignment="Top"
                                         Padding="11,6"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         AutomationProperties.AutomationId="KeepAliveMessageBox"
                                         AutomationProperties.Name="{Binding [KeepAlive.MessageTitle], Source={StaticResource Loc}}"
                                         Style="{StaticResource FieldTextBoxStyle}"
                                         ToolTip="{Binding [KeepAlive.MessageHint], Source={StaticResource Loc}}"
                                         Text="{Binding KeepAliveMessage, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Margin="12,7,12,0"
                                           VerticalAlignment="Top"
                                           AutomationProperties.AutomationId="KeepAliveMessageWatermark"
                                           Text="{Binding [KeepAlive.MessageWatermark], Source={StaticResource Loc}}"
                                           Foreground="{DynamicResource InkSubtleBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasKeepAliveMessage}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="KeepAliveThreadStage"
                                  Grid.Row="2"
                                  Margin="0,10,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl AutomationProperties.AutomationId="KeepAliveThreadList"
                                      ItemsSource="{Binding KeepAliveThreads}">
                            <!-- Two implicit templates keyed on type, because the list mixes section
                                 headings with conversation rows the way the conversation index does. WPF
                                 picks by DataContext type, so neither template needs to know about the
                                 other. -->
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type vm:KeepAliveSectionViewModel}">
                                    <ToggleButton x:Name="KeepAliveSectionRow"
                                                  AutomationProperties.AutomationId="KeepAliveSectionEntry"
                                                  AutomationProperties.Name="{Binding Title}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                  HorizontalContentAlignment="Stretch"
                                                  Cursor="Hand"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="2,9,2,5"
                                                  Margin="0,1">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="22" />
                                            </Grid.ColumnDefinitions>
                                            <!-- A project heading is indented one level, so the two
                                                 levels of grouping stay legible without a tree line. -->
                                            <Border x:Name="KeepAliveSectionIndent"
                                                    Grid.Column="0"
                                                    Width="0" />
                                            <TextBlock x:Name="KeepAliveSectionTitle"
                                                       Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource InkMutedBrush}" />
                                            <TextBlock x:Name="KeepAliveSectionCount"
                                                       Grid.Column="2"
                                                       Text="{Binding CountText}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource InkSubtleBrush}" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ExpandGlyph}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource InkSubtleBrush}" />
                                        </Grid>
                                    </ToggleButton>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsProject}" Value="True">
                                            <Setter TargetName="KeepAliveSectionIndent" Property="Width" Value="14" />
                                            <Setter TargetName="KeepAliveSectionTitle" Property="FontWeight" Value="Medium" />
                                            <Setter TargetName="KeepAliveSectionTitle" Property="FontSize" Value="11.5" />
                                        </DataTrigger>
                                        <!-- Held sections carry the same green the held rows do, so a
                                             collapsed section still says whether anything under it is on. -->
                                        <DataTrigger Binding="{Binding HasHeld}" Value="True">
                                            <Setter TargetName="KeepAliveSectionCount" Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:KeepAliveThreadViewModel}">
                                    <!-- Same measurements and surface as a conversation row on the
                                         conversations page. A row that means "a conversation" should look
                                         the same wherever it appears; only the trailing control differs,
                                         because here the row is a setting rather than a link. -->
                                    <Border x:Name="KeepAliveRow"
                                            MinHeight="58"
                                            Margin="0,2"
                                            Background="{DynamicResource ConversationSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            SnapsToDevicePixels="True">
                                      <Grid>
                                        <!-- Hover is a veil faded by Opacity, not a ColorAnimation on the
                                             row fill: ColorAnimation.To cannot take a DynamicResource, so
                                             animating the fill would hard-code one theme's colors and leave
                                             the row dark under the light theme. The veil keeps both the base
                                             surface and the hover tint on theme resources. -->
                                        <Border x:Name="KeepAliveHoverVeil"
                                                Background="{DynamicResource ConversationHoverBrush}"
                                                CornerRadius="9"
                                                IsHitTestVisible="False"
                                                Opacity="0" />
                                        <Grid Margin="10,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="KeepAliveAccent"
                                                    Grid.Column="0"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource BorderStrongBrush}" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding LastSentText}"
                                                           Margin="0,3,0,0"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasLastSent}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Two controls, not one three-way selector: the hold is this
                                                 conversation's own switch, and nominating it as the
                                                 sentinel's destination is a different decision that only
                                                 one row in the list can win. Folding them into one
                                                 selector implied they were alternatives. -->
                                            <StackPanel Grid.Column="3"
                                                        Margin="12,0,0,0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button x:Name="KeepAliveNominate"
                                                        AutomationProperties.AutomationId="KeepAliveNominateSentinel"
                                                        AutomationProperties.Name="{Binding [KeepAlive.SentinelPickHint], Source={StaticResource Loc}}"
                                                        Command="{Binding NominateSentinelCommand}"
                                                        Margin="0,0,7,0"
                                                        Style="{StaticResource IconButtonStyle}"
                                                        ToolTip="{Binding [KeepAlive.SentinelPickHint], Source={StaticResource Loc}}">
                                                    <TextBlock x:Name="KeepAliveNominateGlyph"
                                                               Text="&#xE7C1;"
                                                               FontFamily="{StaticResource IconFont}" />
                                                </Button>
                                                <ToggleButton Tag="&#xEC0A;"
                                                              AutomationProperties.AutomationId="KeepAliveHoldToggle"
                                                              Content="{Binding [KeepAlive.ThreadHold], Source={StaticResource Loc}}"
                                                              IsChecked="{Binding IsHeldByUser, Mode=TwoWay}"
                                                              Margin="0"
                                                              Style="{StaticResource TitleBarSwitchStyle}" />
                                            </StackPanel>
                                        </Grid>
                                      </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsHeld}" Value="True">
                                            <Setter TargetName="KeepAliveAccent" Property="Background" Value="{DynamicResource GreenBrush}" />
                                            <Setter TargetName="KeepAliveRow" Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
                                        </DataTrigger>
                                        <!-- The destination reads as chosen whether or not it is currently
                                             sending, because the choice is the user's and it persists; the
                                             two situations are told apart by the accent below. -->
                                        <DataTrigger Binding="{Binding IsSentinelDestination}" Value="True">
                                            <Setter TargetName="KeepAliveNominateGlyph" Property="Text" Value="&#xE7C0;" />
                                            <Setter TargetName="KeepAliveNominateGlyph" Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                            <Setter TargetName="KeepAliveRow" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                        <!-- Chosen as the destination but the endpoint has not proved itself
                                             open yet. Nothing is being sent, so the accent must not claim
                                             the row is held. -->
                                        <DataTrigger Binding="{Binding IsSentinelWaitingForSignal}" Value="True">
                                            <Setter TargetName="KeepAliveAccent" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        </DataTrigger>
                                        <!-- Waiting on recovery outranks held: the row is enrolled but
                                             deliberately silent, and the accent is what says so without a
                                             sentence of explanation. -->
                                        <DataTrigger Binding="{Binding IsWaitingForRecovery}" Value="True">
                                            <Setter TargetName="KeepAliveAccent" Property="Background" Value="{DynamicResource YellowBrush}" />
                                            <Setter TargetName="KeepAliveRow" Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                                        </DataTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseEnter" SourceName="KeepAliveRow">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KeepAliveHoverVeil"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0.72"
                                                                     Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Border.MouseLeave" SourceName="KeepAliveRow">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="KeepAliveHoverVeil"
                                                                     Storyboard.TargetProperty="Opacity"
                                                                     To="0"
                                                                     Duration="0:0:0.2">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>

                    <!-- The evidence column. The status line under the page title degrades this same
                         snapshot into one sentence, which is right for a glance but cannot answer the
                         question the user actually asked of this page: it sends nothing the user can see,
                         because a heartbeat lands in the conversation as an ordinary message and the
                         schedule behind it leaves no trace. So: the readings, then the wording as sent. -->
                    <Border x:Name="KeepAliveRuntimeStage"
                            Grid.Column="1"
                            Width="300"
                            Margin="12,0,4,0"
                            Padding="16,14,16,14"
                            VerticalAlignment="Top"
                            Background="{DynamicResource GlassSurfaceBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="{Binding [KeepAlive.RuntimeTitle], Source={StaticResource Loc}}"
                                       Style="{StaticResource SectionHeaderStyle}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="{Binding [KeepAlive.RuntimeHeldLabel], Source={StaticResource Loc}}"
                                           Margin="0,0,0,6"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           AutomationProperties.AutomationId="KeepAliveHeldCountValue"
                                           Text="{Binding KeepAliveHeldCountText}"
                                           Margin="12,0,0,6"
                                           Foreground="{DynamicResource InkBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1"
                                           Text="{Binding [KeepAlive.RuntimeNextDueLabel], Source={StaticResource Loc}}"
                                           Margin="0,0,0,6"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           FontSize="11" />
                                <!-- Clock time plus a countdown, because the time alone cannot say whether
                                     anything is running: the dash it degrades to when nothing is scheduled
                                     reads as "not due yet" no matter which gate is actually holding it. The
                                     second line carries either the remaining time or that gate. -->
                                <StackPanel Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="12,0,0,6"
                                            HorizontalAlignment="Right">
                                    <TextBlock AutomationProperties.AutomationId="KeepAliveNextDueValue"
                                               Text="{Binding KeepAliveNextDueText}"
                                               Foreground="{DynamicResource InkBrush}"
                                               FontSize="12"
                                               TextAlignment="Right"
                                               Style="{StaticResource MonoTextStyle}" />
                                    <TextBlock AutomationProperties.AutomationId="KeepAliveNextDueDetailValue"
                                               Text="{Binding KeepAliveNextDueDetailText}"
                                               Margin="0,2,0,0"
                                               MaxWidth="150"
                                               Foreground="{DynamicResource InkMutedBrush}"
                                               FontSize="10"
                                               TextAlignment="Right"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasKeepAliveNextDueDetail, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding [KeepAlive.RuntimeWaitingLabel], Source={StaticResource Loc}}"
                                           Margin="0,0,0,6"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="{Binding KeepAliveWaitingCountText}"
                                           Margin="12,0,0,6"
                                           Foreground="{DynamicResource InkBrush}"
                                           FontSize="12" />
                                <TextBlock Grid.Row="3"
                                           Text="{Binding [KeepAlive.RuntimeSentinelLabel], Source={StaticResource Loc}}"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           FontSize="11" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           AutomationProperties.AutomationId="KeepAliveSentinelStateValue"
                                           Text="{Binding KeepAliveSentinelStateText}"
                                           Margin="12,0,0,0"
                                           Foreground="{DynamicResource InkBrush}"
                                           FontSize="12"
                                           TextAlignment="Right"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Border Margin="0,14,0,0"
                                    Height="1"
                                    Background="{DynamicResource BorderBrush}" />

                            <TextBlock Text="{Binding [KeepAlive.SendsTitle], Source={StaticResource Loc}}"
                                       Margin="0,14,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{Binding [KeepAlive.SendsHint], Source={StaticResource Loc}}"
                                       Margin="0,4,0,0"
                                       Style="{StaticResource FieldHintStyle}" />

                            <TextBlock Text="{Binding [KeepAlive.SendsEmpty], Source={StaticResource Loc}}"
                                       Margin="0,10,0,0"
                                       Foreground="{DynamicResource InkSubtleBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasKeepAliveRecentSends}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Capped in height rather than scrolling with the page: this is a window onto
                                 recent behaviour, and the coordinator only keeps a dozen. -->
                            <ScrollViewer Margin="0,8,0,0"
                                          MaxHeight="260"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasKeepAliveRecentSends, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl AutomationProperties.AutomationId="KeepAliveRecentSendList"
                                              ItemsSource="{Binding KeepAliveRecentSends}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="10,7,10,7"
                                                    Background="{DynamicResource SurfaceSubtleBrush}"
                                                    CornerRadius="7">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding ThreadName}"
                                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding TimeText}"
                                                                   Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource InkSubtleBrush}"
                                                                   FontSize="10"
                                                                   Style="{StaticResource MonoTextStyle}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}"
                                                               Margin="0,3,0,0"
                                                               Foreground="{DynamicResource InkBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Preferences -->
            <Grid x:Name="PreferencesPageRoot"
                  Margin="16,0,16,16"
                  Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="PreferencesHeaderStage"
                            Margin="4,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding [Shell.Preferences], Source={StaticResource Loc}}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Border VerticalAlignment="Bottom"
                        Height="1"
                        Margin="4,0"
                        Background="{DynamicResource BorderBrush}" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="4,20,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel x:Name="PreferencesInterfaceStage"
                                    Margin="0,0,28,0">
                            <TextBlock Text="{Binding [Settings.InterfaceTitle], Source={StaticResource Loc}}"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <ComboBox AutomationProperties.Name="{Binding [Settings.InterfaceTitle], Source={StaticResource Loc}}"
                                      Margin="0,10,0,0"
                                      ItemsSource="{Binding AvailableLanguages}"
                                      ItemContainerStyle="{StaticResource NamedOptionComboBoxItemStyle}"
                                      ItemTemplate="{StaticResource NamedOptionTemplate}"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding UiLanguage, Mode=TwoWay}"
                                      Style="{StaticResource FieldComboBoxStyle}" />

                            <!-- Reuses ToggleThemeCommand rather than binding UiTheme, which is read-only on
                                 purpose: switching runs the radial transition, and a direct write would skip it.
                                 The animation still originates at the title-bar control, which is where the
                                 theme lives. -->
                            <TextBlock Text="{Binding [Settings.AppearanceTitle], Source={StaticResource Loc}}"
                                       Margin="0,22,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [Settings.ThemeLabel], Source={StaticResource Loc}}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBlock Margin="0,3,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldHintStyle}">
                                                <Setter Property="Text"
                                                        Value="{Binding [Settings.ThemeLight], Source={StaticResource Loc}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                        <Setter Property="Text"
                                                                Value="{Binding [Settings.ThemeDark], Source={StaticResource Loc}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding ToggleThemeCommand}"
                                        AutomationProperties.AutomationId="PreferencesThemeToggle"
                                        AutomationProperties.Name="{Binding ThemeToggleText}"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        ToolTip="{Binding ThemeToggleText}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0"
                                                   FontFamily="{StaticResource IconFont}"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE706;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                            <Setter Property="Text" Value="&#xE708;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ThemeToggleText}"
                                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Margin="0,22,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0" />
                            <TextBlock Text="{Binding [Settings.DataTitle], Source={StaticResource Loc}}"
                                       Margin="0,18,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />

                            <Button Command="{Binding OpenDataFolderCommand}"
                                    AutomationProperties.Name="{Binding [Sidebar.OpenDataAndLogs], Source={StaticResource Loc}}"
                                    Margin="0,20,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;"
                                               Margin="0,0,8,0"
                                               FontFamily="{StaticResource IconFont}"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    <TextBlock Text="{Binding [Sidebar.OpenDataAndLogs], Source={StaticResource Loc}}"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                </StackPanel>
                            </Button>

                            <Border Margin="0,16,0,0"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0" />
                            <TextBlock Text="{Binding [Settings.UserGuideTitle], Source={StaticResource Loc}}"
                                       Margin="0,18,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <TextBlock Text="{Binding [Settings.UserGuideHint], Source={StaticResource Loc}}"
                                       Margin="0,4,0,0"
                                       Opacity="0.6"
                                       FontSize="12" />
                            <Button Command="{Binding OpenUserGuideCommand}"
                                    AutomationProperties.Name="{Binding [Settings.UserGuideTitle], Source={StaticResource Loc}}"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F4;"
                                               Margin="0,0,8,0"
                                               FontFamily="{StaticResource IconFont}"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                    <TextBlock Text="{Binding [Settings.UserGuideTitle], Source={StaticResource Loc}}"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{DynamicResource BorderBrush}" />

                        <StackPanel x:Name="PreferencesBehaviorStage"
                                    Grid.Column="2"
                                    Margin="28,0,0,0">
                            <TextBlock Text="{Binding [Settings.StartupTitle], Source={StaticResource Loc}}"
                                       Style="{StaticResource SectionHeaderStyle}" />

                            <Grid Margin="0,14,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Policy.StartWithWindows], Source={StaticResource Loc}}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                          Style="{StaticResource ToggleCheckStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Policy.MinimizeToTray], Source={StaticResource Loc}}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                          Style="{StaticResource ToggleCheckStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Policy.PreventSystemSleep], Source={StaticResource Loc}}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <CheckBox Grid.Column="1"
                                          AutomationProperties.AutomationId="PreventSystemSleepSwitch"
                                          AutomationProperties.Name="{Binding [Policy.PreventSystemSleep], Source={StaticResource Loc}}"
                                          IsChecked="{Binding PreventSystemSleep, Mode=TwoWay}"
                                          Style="{StaticResource ToggleCheckStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding [Policy.PreventSystemSleepHint], Source={StaticResource Loc}}"
                                       Margin="0,0,0,20"
                                       Style="{StaticResource FieldHintStyle}" />

                            <!-- The one outbound request this program makes. It gets a visible switch rather
                                 than a buried one because "this talks to the network" is something a user is
                                 entitled to find without going looking for it. -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Settings.UpdateCheck], Source={StaticResource Loc}}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <CheckBox Grid.Column="1"
                                          AutomationProperties.AutomationId="UpdateCheckSwitch"
                                          AutomationProperties.Name="{Binding [Settings.UpdateCheck], Source={StaticResource Loc}}"
                                          IsChecked="{Binding UpdateCheckEnabled, Mode=TwoWay}"
                                          Style="{StaticResource ToggleCheckStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding [Settings.UpdateCheckHint], Source={StaticResource Loc}}"
                                       Margin="0,0,0,10"
                                       Style="{StaticResource FieldHintStyle}" />
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UpdateStatusText}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource FieldHintStyle}" />
                                    <TextBlock Text="{Binding CurrentVersionLabelText}"
                                               Margin="0,2,0,0"
                                               Style="{StaticResource FieldHintStyle}" />
                                </StackPanel>
                                <!-- The command disables itself while a check is in flight, so the button
                                     greying out is the progress indicator; the status line says the rest. -->
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="CheckForUpdateButton"
                                        Command="{Binding CheckForUpdateCommand}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        ToolTip="{Binding [Settings.CheckNowHint], Source={StaticResource Loc}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;"
                                                   FontFamily="{StaticResource IconFont}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding [Settings.CheckNow], Source={StaticResource Loc}}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,1,0,0" />
                            <TextBlock Text="{Binding [Settings.DiscoveryTitle], Source={StaticResource Loc}}"
                                       Margin="0,18,0,0"
                                       Style="{StaticResource SectionHeaderStyle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding [Settings.IncludeSubAgents], Source={StaticResource Loc}}"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <CheckBox Grid.Column="1"
                                          IsChecked="{Binding IncludeSubAgents, Mode=TwoWay}"
                                          Style="{StaticResource ToggleCheckStyle}" />
                            </Grid>

                            <!-- The scan already honoured both of these; neither had a control anywhere. The
                                 count is the one the conversation list blames when it says it hit the ceiling. -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding [Settings.RecentThreadLimit], Source={StaticResource Loc}}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <TextBox AutomationProperties.AutomationId="RecentThreadLimitInput"
                                             AutomationProperties.Name="{Binding [Settings.RecentThreadLimit], Source={StaticResource Loc}}"
                                             Margin="0,7,0,0"
                                             Style="{StaticResource FieldTextBoxStyle}"
                                             Text="{Binding RecentThreadLimit, UpdateSourceTrigger=LostFocus}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding [Settings.RecentThreadLookbackDays], Source={StaticResource Loc}}"
                                               Style="{StaticResource FieldLabelStyle}" />
                                    <Grid Margin="0,7,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox AutomationProperties.AutomationId="RecentThreadLookbackInput"
                                                 AutomationProperties.Name="{Binding [Settings.RecentThreadLookbackDays], Source={StaticResource Loc}}"
                                                 Style="{StaticResource FieldTextBoxStyle}"
                                                 Text="{Binding RecentThreadLookbackDays, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding [Settings.DaysUnit], Source={StaticResource Loc}}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   FontSize="11" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding [Settings.DiscoveryScopeHint], Source={StaticResource Loc}}"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource FieldHintStyle}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- User Guide -->
            <Frame x:Name="UserGuidePageRoot"
                   Margin="16,0,16,16"
                   Visibility="Collapsed"
                   NavigationUIVisibility="Hidden"
                   Source="Views/UserGuidePage.xaml">
                <Frame.Style>
                    <Style TargetType="Frame">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsUserGuidePage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Frame.Style>
