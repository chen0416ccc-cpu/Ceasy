<Window x:Class="CodexGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationCore"
        xmlns:controls="clr-namespace:CodexGuardian.Controls"
        xmlns:models="clr-namespace:CodexGuardian.Models"
        xmlns:vm="clr-namespace:CodexGuardian.ViewModels"
        Title="{Binding [App.Title], Source={StaticResource Loc}}"
        Icon="/CodexGuardian;component/Assets/CeasyLogo.png"
        Width="1380"
        Height="860"
        MinWidth="1024"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        StateChanged="Window_StateChanged"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Auto"
        Activated="Window_Activated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52"
                            ResizeBorderThickness="6"
                            CornerRadius="8"
                            GlassFrameThickness="1"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

        <Grid x:Name="ShellRoot"
              Opacity="0"
              Background="{DynamicResource CanvasBrush}"
              RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="ShellRootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                Background="{DynamicResource AmbientGlowBrush}"
                Opacity="0.045"
                IsHitTestVisible="False" />

        <Border x:Name="ShellEdgeFrame"
                Grid.RowSpan="2"
                Grid.ColumnSpan="2"
                BorderBrush="{DynamicResource WindowEdgeBrush}"
                BorderThickness="1"
                CornerRadius="8"
                IsHitTestVisible="False"
                Panel.ZIndex="900" />

        <!-- The old shell snapshot is clipped by a growing radial hole during theme changes. -->
        <Grid x:Name="ThemeTransitionOverlay"
              Grid.RowSpan="2"
              Grid.ColumnSpan="2"
              Panel.ZIndex="1000"
              Visibility="Collapsed"
              IsHitTestVisible="False">
            <Image x:Name="ThemeTransitionSnapshot"
                   Stretch="Fill"
                   SnapsToDevicePixels="True"
                   IsHitTestVisible="False" />
        </Grid>

        <!-- Focus Workspace title bar -->
        <Border Grid.Row="0"
                Grid.Column="1"
                Background="{DynamicResource GlassSurfaceStrongBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="18,0,0,0"
                             Orientation="Horizontal"
                             VerticalAlignment="Center">
                    <!-- The two Runs must stay on one line with no whitespace between them.
                         XAML collapses the newline and indentation into a literal space, which
                         rendered the wordmark as "Ce asy". -->
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="15"
                               FontWeight="SemiBold"><Run Text="Ce" /><Run Text="asy" Foreground="{DynamicResource SignatureBrush}" /></TextBlock>

                    <Border Width="1"
                            Margin="16,11,14,11"
                            Background="{DynamicResource BorderBrush}" />

                    <!-- The two master switches, reachable from every page. They gate whole
                         subsystems rather than belonging to any one screen, so burying them inside a
                         settings page meant the user had to navigate away from the conversations to
                         turn protection on. Hit-testing is opted in per control because the caption
                         area otherwise swallows the click into a window drag. -->
                    <ToggleButton Tag="&#xE72E;"
                                  Content="{Binding [Mode.Title], Source={StaticResource Loc}}"
                                  AutomationProperties.AutomationId="AutoRecoveryMasterSwitch"
                                  AutomationProperties.Name="{Binding [Mode.Title], Source={StaticResource Loc}}"
                                  IsChecked="{Binding AutoRecoveryEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding CanToggleAutoRecovery}"
                                  Style="{StaticResource TitleBarSwitchStyle}"
                                  ToolTip="{Binding ProtectionModeDescription}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    <ToggleButton Tag="&#xEC0A;"
                                  Content="{Binding [Shell.KeepAlive], Source={StaticResource Loc}}"
                                  AutomationProperties.AutomationId="KeepAliveMasterSwitch"
                                  AutomationProperties.Name="{Binding [Shell.KeepAlive], Source={StaticResource Loc}}"
                                  IsChecked="{Binding KeepAliveEnabled, Mode=TwoWay}"
                                  Style="{StaticResource TitleBarSwitchStyle}"
                                  ToolTip="{Binding KeepAliveStatusText}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                             Orientation="Horizontal"
                             VerticalAlignment="Stretch"
                             shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Margin="0,9,10,9"
                             Padding="10,0"
                             Background="{DynamicResource GlassSurfaceBrush}"
                             BorderBrush="{DynamicResource GlassBorderBrush}"
                             BorderThickness="1"
                             CornerRadius="6">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <!-- Guard state used to be a single Ellipse whose Fill was swapped by a
                                 DataTrigger, so the one confirmation the title-bar switch produced
                                 arrived in a single frame - the switch itself animated, the light next
                                 to it did not. Four layers instead: the two colours cross-fade, a soft
                                 halo breathes, and a ripple travels outward - all only while guarding
                                 is actually on, which is what tells the state apart from across the
                                 room. Driven from code-behind because a Storyboard inside a Style
                                 cannot resolve TargetName against the window's name scope. -->
                            <Grid Width="7"
                                  Height="7"
                                  Margin="0,0,7,0"
                                  VerticalAlignment="Center">
                                <!-- The ripple is what stops this reading as a blinking lamp. A halo
                                     that pulses brighter and bigger on the same beat is a pulse, and a
                                     hard-edged disc pulsing in place is the cheapest possible one - it
                                     is the flashing sprite of a feature-phone game. Light that is
                                     alive travels: this ring is born at the dot's edge and expands
                                     while fading out, so the eye reads outward motion instead of
                                     on/off. Same trick as the halo below - the Fill stays on the
                                     palette brush and an OpacityMask does the shaping, because a
                                     GradientStop Color cannot take a DynamicResource and hard-coding
                                     one would strand this dot outside the theme the way the keep-alive
                                     row was. Transparent through 0.55 leaves the middle hollow, so
                                     what expands is a soft wavefront rather than a growing blob. -->
                                <Ellipse x:Name="GuardStatusRipple"
                                         Width="15"
                                         Height="15"
                                         Margin="-4"
                                         Fill="{DynamicResource GreenBrush}"
                                         IsHitTestVisible="False"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.OpacityMask>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#00FFFFFF" />
                                            <GradientStop Offset="0.55" Color="#00FFFFFF" />
                                            <GradientStop Offset="0.82" Color="#FFFFFFFF" />
                                            <GradientStop Offset="1" Color="#00FFFFFF" />
                                        </RadialGradientBrush>
                                    </Ellipse.OpacityMask>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="GuardStatusRippleScale" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <!-- Negative margin so the halo can grow past the dot without
                                     widening the row and shifting the summary text. The mask fades it
                                     to nothing at its own edge: an unmasked disc has a hard rim, and a
                                     hard rim changing opacity is what the eye calls a flash rather
                                     than a glow. -->
                                <Ellipse x:Name="GuardStatusHalo"
                                         Width="15"
                                         Height="15"
                                         Margin="-4"
                                         Fill="{DynamicResource GreenBrush}"
                                         IsHitTestVisible="False"
                                         Opacity="0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.OpacityMask>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                                            <GradientStop Offset="0.5" Color="#DCFFFFFF" />
                                            <GradientStop Offset="1" Color="#00FFFFFF" />
                                        </RadialGradientBrush>
                                    </Ellipse.OpacityMask>
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform x:Name="GuardStatusHaloScale" ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse x:Name="GuardStatusIdle"
                                         Fill="{DynamicResource OrangeBrush}"
                                         IsHitTestVisible="False" />
                                <Ellipse x:Name="GuardStatusLive"
                                         Fill="{DynamicResource GreenBrush}"
                                         IsHitTestVisible="False"
                                         Opacity="0" />
                            </Grid>
                            <TextBlock Text="{Binding MonitoringSummaryText}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       FontSize="11"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <!-- Hidden until a check actually finds something newer. This is the loud half of the
                         update signal; the dot on the brand mark is the quiet half. -->
                    <Button AutomationProperties.AutomationId="UpdateUtilityButton"
                            AutomationProperties.Name="{Binding [Shell.UpdateAvailable], Source={StaticResource Loc}}"
                            Command="{Binding OpenProjectPageCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{Binding BrandToolTipText}"
                            Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="&#xE895;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14" />
                    </Button>

                    <Border Width="1"
                            Margin="4,10"
                            Background="{DynamicResource BorderBrush}" />

                    <Button Click="Minimize_Click"
                            AutomationProperties.Name="{Binding [Window.Minimize], Source={StaticResource Loc}}"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="{Binding [Window.Minimize], Source={StaticResource Loc}}">
                        <TextBlock Text="&#xE921;"
                                   FontFamily="{StaticResource IconFont}" />
                    </Button>
                    <Button x:Name="MaximizeButton"
                            Click="Maximize_Click"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}">
                        <TextBlock x:Name="MaximizeGlyph"
                                   Text="&#xE922;"
                                   FontFamily="{StaticResource IconFont}" />
                    </Button>
                    <Button Click="Close_Click"
                            AutomationProperties.Name="{Binding [Window.CloseToTray], Source={StaticResource Loc}}"
                            Style="{StaticResource CloseWindowButtonStyle}"
                            ToolTip="{Binding [Window.CloseToTray], Source={StaticResource Loc}}">
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="{StaticResource IconFont}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Focus Workspace product rail -->
        <Border Grid.RowSpan="2"
                Grid.Column="0"
                Background="{DynamicResource GlassSurfaceStrongBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <!-- The logo doubles as the project link. It sits in the window chrome, so it needs the
                         explicit hit-test opt-in above; without it the click is swallowed by window dragging.
                         The button draws nothing of its own — see BrandButtonStyle — because the mark already
                         has a hover animation and a second surface behind it would read as another control. -->
                    <Button Width="34"
                            Height="34"
                            Command="{Binding OpenProjectPageCommand}"
                            AutomationProperties.AutomationId="BrandProjectButton"
                            AutomationProperties.Name="Ceasy"
                            Style="{StaticResource BrandButtonStyle}"
                            ToolTip="{Binding BrandToolTipText}">
                        <Grid Width="34" Height="34">
                            <Image x:Name="BrandMark"
                                   Width="28"
                                   Height="28"
                                   Source="/CodexGuardian;component/Assets/CeasyLogo.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Image.RenderTransform>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <!-- Bound to the button rather than the image so the whole 34px
                                                 target reacts: the area that responds to a click and the area
                                                 that responds to the pointer are then the same area. -->
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                                         Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1.08"
                                                                             Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1.08"
                                                                             Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.5" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                             To="1"
                                                                             Duration="0:0:0.22">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                             To="1"
                                                                             Duration="0:0:0.22">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- The update badge is a dot, not a count: the one thing the tooltip cannot say
                                 at a glance is "there is something new". The ring is the titlebar's own
                                 surface colour so the dot stays readable over the logo's edge, and it is not
                                 hit-testable so it never steals the click from the button underneath. -->
                            <Border Width="9"
                                    Height="9"
                                    Margin="0,1,1,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    CornerRadius="4.5"
                                    Background="{DynamicResource PrimaryBrush}"
                                    BorderBrush="{DynamicResource GlassSurfaceStrongBrush}"
                                    BorderThickness="1.5"
                                    IsHitTestVisible="False"
                                    Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,14,0,0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top">
                    <!-- Selection is also carried by the button's own tinted background, but that
                         swaps in one frame. This bar is the part that moves: RailIndicatorOffset
                         slides it to the selected button while RailIndicatorStretch briefly
                         elongates it, so the eye can follow where selection went. Driven from
                         AnimateRailIndicator in the code-behind because the target offset depends
                         on which page index is selected. -->
                    <Border x:Name="RailSelectionIndicator"
                            Width="3"
                            Height="20"
                            CornerRadius="1.5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="-7.5,0,0,0"
                            Background="{DynamicResource PrimaryBrush}"
                            IsHitTestVisible="False"
                            Opacity="0">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="RailIndicatorStretch" ScaleY="1" CenterY="10" />
                                <TranslateTransform x:Name="RailIndicatorOffset" Y="15" />
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>

                    <!-- Indentation of this panel's children is left as it was so the navigation
                         buttons stay diff-comparable against the pre-indicator layout. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="Tasks"
                            AutomationProperties.AutomationId="ConversationsScopeButton"
                            AutomationProperties.Name="{Binding [Shell.Conversations], Source={StaticResource Loc}}"
                            ToolTip="{Binding [Shell.Conversations], Source={StaticResource Loc}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTasksNavigationSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE8BD;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>

                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="Overview"
                            AutomationProperties.AutomationId="ActivityScopeButton"
                            AutomationProperties.Name="{Binding [Shell.Activity], Source={StaticResource Loc}}"
                            ToolTip="{Binding [Shell.Activity], Source={StaticResource Loc}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOverviewPage}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE9D9;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>

                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="Recovery"
                            AutomationProperties.AutomationId="GuardrailsScopeButton"
                            AutomationProperties.Name="{Binding [Shell.Guardrails], Source={StaticResource Loc}}"
                            ToolTip="{Binding [Shell.Guardrails], Source={StaticResource Loc}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecoveryPage}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xEA18;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>

                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="KeepAlive"
                            AutomationProperties.AutomationId="KeepAliveScopeButton"
                            AutomationProperties.Name="{Binding [Shell.KeepAlive], Source={StaticResource Loc}}"
                            ToolTip="{Binding [Shell.KeepAlive], Source={StaticResource Loc}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeepAlivePage}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE945;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>

                    <Button Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            AutomationProperties.AutomationId="PreferencesScopeButton"
                            AutomationProperties.Name="{Binding [Shell.Preferences], Source={StaticResource Loc}}"
                            ToolTip="{Binding [Shell.Preferences], Source={StaticResource Loc}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RailNavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                        <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE713;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>
                </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding OpenProjectPageCommand}"
                            AutomationProperties.AutomationId="ProjectUtilityButton"
                            AutomationProperties.Name="{Binding [Shell.Project], Source={StaticResource Loc}}"
                            Style="{StaticResource RailUtilityButtonStyle}"
                            ToolTip="{Binding BrandToolTipText}">
                        <TextBlock Text="&#xE8A7;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                    </Button>

                    <Button x:Name="ThemeUtilityButton"
                            Command="{Binding ToggleThemeCommand}"
                            AutomationProperties.AutomationId="ThemeUtilityButton"
                            AutomationProperties.Name="{Binding ThemeToggleText}"
                            Style="{StaticResource RailUtilityButtonStyle}"
                            ToolTip="{Binding ThemeToggleText}">
                        <TextBlock FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE706;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Text" Value="&#xE708;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceViewport"
              Grid.Row="1"
              Grid.Column="1"
              Background="Transparent"
              RenderTransformOrigin="0.5,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="WorkspaceViewportTransform" />
            </Grid.RenderTransform>

            <!-- Conversations studio -->
            <Grid x:Name="TasksPageRoot"
                  Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTasksPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Conversation index -->
                <Grid x:Name="TasksIndexPane"
                      Grid.Column="0"
                      Background="{DynamicResource GlassSurfaceBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="54" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid x:Name="TasksIndexHeaderStage"
                          Margin="18,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                x:Name="ConversationGroupBackButton"
                                AutomationProperties.AutomationId="ConversationGroupBackButton"
                                AutomationProperties.Name="{Binding [FollowUp.BackToTasks], Source={StaticResource Loc}}"
                                Command="{Binding BackToConversationNavigationCommand}"
                                Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                ToolTip="{Binding [FollowUp.BackToTasks], Source={StaticResource Loc}}">
                            <TextBlock Text="&#xE72B;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12" />
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConversationNavigationDetail}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="{Binding [Shell.Conversations], Source={StaticResource Loc}}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="17"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConversationNavigationDetail}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ConversationGroupTitle}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="17"
                                       FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConversationNavigationDetail}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding TaskCount}"
                                       Foreground="{DynamicResource InkSubtleBrush}"
                                       FontSize="11"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="TasksSearchStage"
                          Grid.Row="1"
                          Height="40"
                          Margin="18,2,14,10"
                          VerticalAlignment="Center">
                        <TextBox Text="{Binding TaskSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.AutomationId="ConversationSearchTextBox"
                                 AutomationProperties.Name="{Binding [Shell.SearchConversations], Source={StaticResource Loc}}"
                                 Background="{DynamicResource GlassSurfaceStrongBrush}"
                                 Padding="34,0,38,0"
                                 TextAlignment="Left"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource FieldTextBoxStyle}"
                                 ToolTip="{Binding [Tasks.SearchHint], Source={StaticResource Loc}}" />
                        <TextBlock Text="&#xE721;"
                                   Margin="11,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource InkSubtleBrush}"
                                   IsHitTestVisible="False" />
                        <TextBlock Margin="34,0,38,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding [Shell.SearchConversations], Source={StaticResource Loc}}"
                                   Foreground="{DynamicResource InkSubtleBrush}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasTaskSearchText}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Command="{Binding ClearTaskSearchCommand}"
                                AutomationProperties.AutomationId="ClearConversationSearchButton"
                                AutomationProperties.Name="{Binding [Tasks.ClearSearch], Source={StaticResource Loc}}"
                                HorizontalAlignment="Right"
                                Margin="0,5,4,5"
                                Style="{StaticResource CompactIconButtonStyle}"
                                ToolTip="{Binding [Tasks.ClearSearch], Source={StaticResource Loc}}">
                            <Button.Visibility>
                                <Binding Path="HasTaskSearchText">
                                    <Binding.Converter>
                                        <BooleanToVisibilityConverter />
                                    </Binding.Converter>
                                </Binding>
                            </Button.Visibility>
                            <TextBlock Text="&#xE894;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="10" />
                        </Button>
                    </Grid>

                    <Grid x:Name="TasksScopeStage"
                          Grid.Row="2"
                          Margin="18,0,14,0"
                          SizeChanged="OnTasksScopeStageSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Command="{Binding SetConversationScopeCommand}"
                                CommandParameter="All"
                                AutomationProperties.AutomationId="ConversationScopeAllButton"
                                AutomationProperties.Name="{Binding [Shell.AllConversations], Source={StaticResource Loc}}"
                                AutomationProperties.HelpText="{Binding [Tasks.ScopeAllHint], Source={StaticResource Loc}}"
                                ToolTip="{Binding [Tasks.ScopeAllHint], Source={StaticResource Loc}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ConversationFilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAllConversationScope}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="{Binding [Shell.AllConversations], Source={StaticResource Loc}}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                <!-- Watch is bound to the same count the block displays, so the number
                                     swells the moment a monitor pass changes it. These three live in
                                     fixed chrome, not in the virtualized conversation list, which is
                                     the one place the pulse must not be attached. -->
                                <TextBlock Text="{Binding AllConversationCount}"
                                           controls:CountPulse.Watch="{Binding AllConversationCount}"
                                           Margin="6,0,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           Opacity="0.7" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding SetConversationScopeCommand}"
                                CommandParameter="NeedsAttention"
                                AutomationProperties.AutomationId="ConversationScopeAttentionButton"
                                AutomationProperties.Name="{Binding [Shell.AttentionConversations], Source={StaticResource Loc}}"
                                AutomationProperties.HelpText="{Binding [Tasks.ScopeAttentionHint], Source={StaticResource Loc}}"
                                ToolTip="{Binding [Tasks.ScopeAttentionHint], Source={StaticResource Loc}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ConversationFilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNeedsAttentionConversationScope}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="{Binding [Tasks.ScopeAttention], Source={StaticResource Loc}}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                <TextBlock Text="{Binding NeedsAttentionConversationCount}"
                                           controls:CountPulse.Watch="{Binding NeedsAttentionConversationCount}"
                                           Margin="6,0,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           Opacity="0.7" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Command="{Binding SetConversationScopeCommand}"
                                CommandParameter="Archived"
                                AutomationProperties.AutomationId="ConversationScopeArchivedButton"
                                AutomationProperties.Name="{Binding [Tasks.ScopeArchived], Source={StaticResource Loc}}"
                                AutomationProperties.HelpText="{Binding [Tasks.ScopeArchivedHint], Source={StaticResource Loc}}"
                                ToolTip="{Binding [Tasks.ScopeArchivedHint], Source={StaticResource Loc}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ConversationFilterButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsArchivedConversationScope}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock Text="{Binding [Tasks.ScopeArchived], Source={StaticResource Loc}}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                <TextBlock Text="{Binding ArchivedConversationCount}"
                                           controls:CountPulse.Watch="{Binding ArchivedConversationCount}"
                                           Margin="6,0,0,0"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           Opacity="0.7" />
                            </StackPanel>
                        </Button>

                        <!-- Segment selection slides rather than jumping between the three buttons.
                             The bar is declared last so it paints above them, and it now carries the
                             brand outline and soft fill that the buttons used to apply themselves on
                             selection. It cannot sit underneath: ControlSurfaceBrush is fully opaque
                             in the light theme, so an unselected button would swallow the bar
                             mid-travel. PrimarySoftBrush is 20% alpha, so labels stay readable
                             through it. Driven from AnimateConversationScopeIndicator because the
                             travel distance depends on the measured column width. -->
                        <Border x:Name="ConversationScopeIndicator"
                                Grid.Column="0"
                                Height="34"
                                Margin="3,0"
                                CornerRadius="10"
                                Background="{DynamicResource PrimarySoftBrush}"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="1"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ConversationScopeStretch" ScaleX="1" />
                                    <TranslateTransform x:Name="ConversationScopeOffset" X="0" />
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <!-- The resend tally. It is the one place in the app that answers "has it ever
                         actually resent anything" without first requiring the right conversation to
                         be found in a list of well over a hundred. Collapsed until the ledger is
                         non-zero, so a fresh install stays quiet. Clicking it switches to the
                         Attention scope, where the most-resent conversations are ordered first. -->
                    <Button Grid.Row="3"
                            AutomationProperties.AutomationId="RecoveryLedgerSummaryBanner"
                            AutomationProperties.Name="{Binding RecoveryLedgerSummaryText}"
                            AutomationProperties.HelpText="{Binding [Tasks.ResendTallyHint], Source={StaticResource Loc}}"
                            Command="{Binding SetConversationScopeCommand}"
                            CommandParameter="NeedsAttention"
                            Cursor="Hand"
                            Margin="18,0,14,10"
                            HorizontalContentAlignment="Stretch"
                            ToolTip="{Binding [Tasks.ResendTallyHint], Source={StaticResource Loc}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TallyShell"
                                                    Padding="10,7,10,7"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource PrimarySoftBrush}"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource PrimaryBrush}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TallyShell"
                                                            Property="BorderThickness"
                                                            Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnyConfirmedResend}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="&#xE72C;"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkBrush}" />
                            <TextBlock Grid.Column="1"
                                       AutomationProperties.AutomationId="RecoveryLedgerSummaryText"
                                       Text="{Binding RecoveryLedgerSummaryText}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkBrush}" />
                        </Grid>
                    </Button>

                    <Grid x:Name="TasksListStage"
                          Grid.Row="4">
                        <Grid x:Name="ConversationNavigationStage">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConversationNavigationRoot}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ListBox x:Name="ConversationNavigationList"
                                     AutomationProperties.AutomationId="ConversationNavigationIndex"
                                     AutomationProperties.Name="{Binding [Shell.Conversations], Source={StaticResource Loc}}"
                                     PreviewMouseWheel="ConversationList_PreviewMouseWheel"
                                     ItemsSource="{Binding ConversationNavigationEntries}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0,8,0,12"
                                     ItemContainerStyle="{StaticResource FlatListItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.IsDeferredScrollingEnabled="False"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                 <ListBox.ItemTemplate>
                                     <DataTemplate>
                                         <Grid Margin="10,2,10,2" MinHeight="34">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <Button x:Name="SectionEntry"
                                                     Grid.ColumnSpan="2"
                                                     AutomationProperties.AutomationId="ConversationNavigationSection"
                                                     AutomationProperties.Name="{Binding Title}"
                                                     AutomationProperties.HelpText="{Binding [Tasks.ToggleSectionHint], Source={StaticResource Loc}}"
                                                     Command="{Binding DataContext.ToggleConversationSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}"
                                                     HorizontalContentAlignment="Stretch"
                                                     Style="{StaticResource BaseButtonStyle}"
                                                     Background="Transparent"
                                                     BorderBrush="Transparent"
                                                     BorderThickness="0"
                                                     Padding="2,9,2,5"
                                                     Margin="0,1">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="24" />
                                                     </Grid.ColumnDefinitions>
                                                     <TextBlock Text="{Binding Title}"
                                                                FontFamily="{StaticResource DisplayFont}"
                                                                FontSize="12"
                                                                FontWeight="SemiBold"
                                                                Foreground="{DynamicResource InkMutedBrush}" />
                                                     <TextBlock Grid.Column="1"
                                                                Text="{Binding ExpandGlyph}"
                                                                FontFamily="{StaticResource IconFont}"
                                                                FontSize="12"
                                                                HorizontalAlignment="Right"
                                                                Foreground="{DynamicResource InkSubtleBrush}" />
                                                 </Grid>
                                             </Button>

                                             <Button x:Name="ConversationEntry"
                                                      Grid.Column="0"
                                                     AutomationProperties.AutomationId="ConversationNavigationConversationEntry"
                                                     AutomationProperties.Name="{Binding Title}"
                                                     Command="{Binding DataContext.OpenConversationGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}"
                                                     HorizontalContentAlignment="Stretch"
                                                     Style="{StaticResource ConversationButtonStyle}"
                                                     Padding="10,7"
                                                     Margin="0,2"
                                                     Background="{DynamicResource ConversationSurfaceBrush}"
                                                     BorderBrush="{DynamicResource DangerBrush}"
                                                      BorderThickness="1"
                                                      MinHeight="58">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="4" />
                                                         <ColumnDefinition Width="10" />
                                                         <ColumnDefinition Width="*" />
                                                     </Grid.ColumnDefinitions>
                                                     <Border x:Name="ConversationStatusSpine"
                                                             Grid.Column="0"
                                                             CornerRadius="2"
                                                             Background="{DynamicResource DangerBrush}" />
                                                     <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                         <Grid>
                                                             <Grid.ColumnDefinitions>
                                                                 <ColumnDefinition Width="Auto" />
                                                                 <ColumnDefinition Width="*" />
                                                             </Grid.ColumnDefinitions>
                                                             <controls:ActivitySpinner Grid.Column="0"
                                                                                       Margin="0,0,6,0"
                                                                                       VerticalAlignment="Center"
                                                                                       IsActive="{Binding Task.IsRunningSpinnerVisible}"
                                                                                       Visibility="{Binding Task.IsRunningSpinnerVisible, Converter={StaticResource BoolToVisibility}}" />
                                                             <Border Grid.Column="0"
                                                                     Margin="0,0,6,0"
                                                                     Padding="5,0,5,1"
                                                                     MinWidth="18"
                                                                     VerticalAlignment="Center"
                                                                     Background="{DynamicResource YellowSoftBrush}"
                                                                     BorderBrush="{DynamicResource YellowBrush}"
                                                                     BorderThickness="1"
                                                                     CornerRadius="7"
                                                                     ToolTip="{Binding [Tasks.RetryingHint], Source={StaticResource Loc}}">
                                                                 <Border.Style>
                                                                     <Style TargetType="Border">
                                                                         <Setter Property="Visibility" Value="Collapsed" />
                                                                         <Style.Triggers>
                                                                             <DataTrigger Binding="{Binding Task.IsRetryCountVisible}" Value="True">
                                                                                 <Setter Property="Visibility" Value="Visible" />
                                                                             </DataTrigger>
                                                                         </Style.Triggers>
                                                                     </Style>
                                                                 </Border.Style>
                                                                 <TextBlock Text="{Binding Task.RetryCountText}"
                                                                            HorizontalAlignment="Center"
                                                                            Foreground="{DynamicResource YellowBrush}"
                                                                            FontSize="10"
                                                                            FontWeight="Bold" />
                                                             </Border>
                                                             <TextBlock Grid.Column="1"
                                                                        Text="{Binding Title}"
                                                                        FontFamily="{StaticResource DisplayFont}"
                                                                        FontSize="12.5"
                                                                        FontWeight="SemiBold"
                                                                        TextTrimming="CharacterEllipsis" />
                                                         </Grid>
                                                          <TextBlock Text="{Binding Detail}"
                                                                     Margin="0,3,0,0"
                                                                     Foreground="{DynamicResource InkMutedBrush}"
                                                                     FontSize="10.5"
                                                                     TextWrapping="NoWrap"
                                                                     TextTrimming="CharacterEllipsis" />
                                                     </StackPanel>
                                                 </Grid>
                                              </Button>

                                               <Grid x:Name="ArchivedNavigationActions"
                                                     Grid.Column="1"
                                                     Margin="4,2,0,2"
                                                     VerticalAlignment="Center">
                                                   <StackPanel Orientation="Horizontal">
                                                       <StackPanel.Style>
                                                           <Style TargetType="StackPanel">
                                                               <Setter Property="Visibility" Value="Collapsed" />
                                                               <Style.Triggers>
                                                                   <MultiDataTrigger>
                                                                       <MultiDataTrigger.Conditions>
                                                                           <Condition Binding="{Binding IsArchived}" Value="True" />
                                                                           <Condition Binding="{Binding Task.IsDeleteConfirmationOpen}" Value="False" />
                                                                           <Condition Binding="{Binding Task.IsConversationMutationPending}" Value="False" />
                                                                           <Condition Binding="{Binding Task.IsConversationMutationUnavailable}" Value="False" />
                                                                       </MultiDataTrigger.Conditions>
                                                                       <Setter Property="Visibility" Value="Visible" />
                                                                   </MultiDataTrigger>
                                                               </Style.Triggers>
                                                           </Style>
                                                       </StackPanel.Style>
                                                       <Button AutomationProperties.AutomationId="ArchivedNavigationUnarchiveButton"
                                                               AutomationProperties.Name="{Binding [Tasks.Unarchive], Source={StaticResource Loc}}"
                                                               AutomationProperties.HelpText="{Binding Task.UnarchiveActionHint}"
                                                               Command="{Binding DataContext.UnarchiveConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding Task}"
                                                               Width="30"
                                                               Height="30"
                                                               MinHeight="30"
                                                               Style="{StaticResource CompactIconButtonStyle}"
                                                               ToolTipService.ShowOnDisabled="True"
                                                               ToolTip="{Binding Task.UnarchiveActionHint}">
                                                           <TextBlock Text="&#xE72B;"
                                                                      FontFamily="{StaticResource IconFont}"
                                                                      FontSize="13" />
                                                       </Button>
                                                       <Button AutomationProperties.AutomationId="ArchivedNavigationDeleteButton"
                                                               AutomationProperties.Name="{Binding [Tasks.Delete], Source={StaticResource Loc}}"
                                                               AutomationProperties.HelpText="{Binding Task.DeleteActionHint}"
                                                               Command="{Binding DataContext.RequestDeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding Task}"
                                                               Width="30"
                                                               Height="30"
                                                               MinHeight="30"
                                                               Margin="4,0,0,0"
                                                               Style="{StaticResource DangerIconButtonStyle}"
                                                               ToolTipService.ShowOnDisabled="True"
                                                               ToolTip="{Binding Task.DeleteActionHint}">
                                                           <TextBlock Text="&#xE74D;"
                                                                      FontFamily="{StaticResource IconFont}"
                                                                      FontSize="13"
                                                                      Foreground="{DynamicResource DangerBrush}" />
                                                       </Button>
                                                   </StackPanel>

                                                   <StackPanel Orientation="Horizontal">
                                                       <StackPanel.Style>
                                                           <Style TargetType="StackPanel">
                                                               <Setter Property="Visibility" Value="Collapsed" />
                                                               <Style.Triggers>
                                                                   <MultiDataTrigger>
                                                                       <MultiDataTrigger.Conditions>
                                                                           <Condition Binding="{Binding IsArchived}" Value="True" />
                                                                           <Condition Binding="{Binding Task.IsDeleteConfirmationOpen}" Value="True" />
                                                                           <Condition Binding="{Binding Task.IsConversationMutationPending}" Value="False" />
                                                                       </MultiDataTrigger.Conditions>
                                                                       <Setter Property="Visibility" Value="Visible" />
                                                                   </MultiDataTrigger>
                                                               </Style.Triggers>
                                                           </Style>
                                                       </StackPanel.Style>
                                                       <Button AutomationProperties.AutomationId="ArchivedNavigationDeleteConfirmButton"
                                                               AutomationProperties.Name="{Binding [Tasks.DeleteConfirm], Source={StaticResource Loc}}"
                                                               Command="{Binding DataContext.ConfirmDeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding Task}"
                                                               Width="30"
                                                               Height="30"
                                                               MinHeight="30"
                                                               Style="{StaticResource DangerIconButtonStyle}"
                                                               ToolTip="{Binding [Tasks.DeleteConfirm], Source={StaticResource Loc}}">
                                                           <TextBlock Text="&#xE73E;"
                                                                      FontFamily="{StaticResource IconFont}"
                                                                      FontSize="13"
                                                                      Foreground="{DynamicResource DangerBrush}" />
                                                       </Button>
                                                       <Button AutomationProperties.AutomationId="ArchivedNavigationDeleteCancelButton"
                                                               AutomationProperties.Name="{Binding [Tasks.DeleteCancel], Source={StaticResource Loc}}"
                                                               Command="{Binding DataContext.CancelDeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                               CommandParameter="{Binding Task}"
                                                               Width="30"
                                                               Height="30"
                                                               MinHeight="30"
                                                               Margin="4,0,0,0"
                                                               Style="{StaticResource CompactIconButtonStyle}"
                                                               ToolTip="{Binding [Tasks.DeleteCancel], Source={StaticResource Loc}}">
                                                           <TextBlock Text="&#xE711;"
                                                                      FontFamily="{StaticResource IconFont}"
                                                                      FontSize="13" />
                                                       </Button>
                                                   </StackPanel>

                                                   <TextBlock x:Name="ArchivedNavigationMutationUnavailable"
                                                              AutomationProperties.AutomationId="ArchivedNavigationMutationUnavailable"
                                                              AutomationProperties.Name="{Binding Task.ConversationMutationStatusText}"
                                                              AutomationProperties.HelpText="{Binding Task.ConversationMutationStatusText}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              FontFamily="{StaticResource IconFont}"
                                                              FontSize="13"
                                                              Foreground="{DynamicResource InkSubtleBrush}"
                                                              Text="&#xE946;"
                                                              ToolTip="{Binding Task.ConversationMutationStatusText}">
                                                       <TextBlock.Style>
                                                           <Style TargetType="TextBlock">
                                                               <Setter Property="Visibility" Value="Collapsed" />
                                                               <Style.Triggers>
                                                                   <MultiDataTrigger>
                                                                       <MultiDataTrigger.Conditions>
                                                                           <Condition Binding="{Binding IsArchived}" Value="True" />
                                                                           <Condition Binding="{Binding Task.IsConversationMutationUnavailable}" Value="True" />
                                                                           <Condition Binding="{Binding Task.IsConversationMutationPending}" Value="False" />
                                                                       </MultiDataTrigger.Conditions>
                                                                       <Setter Property="Visibility" Value="Visible" />
                                                                   </MultiDataTrigger>
                                                               </Style.Triggers>
                                                           </Style>
                                                       </TextBlock.Style>
                                                   </TextBlock>

                                                   <TextBlock AutomationProperties.AutomationId="ArchivedNavigationMutationProgress"
                                                              AutomationProperties.Name="{Binding [Tasks.MutationPending], Source={StaticResource Loc}}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              FontFamily="{StaticResource IconFont}"
                                                              FontSize="14"
                                                              Text="&#xE895;">
                                                       <TextBlock.Style>
                                                           <Style TargetType="TextBlock">
                                                               <Setter Property="Visibility" Value="Collapsed" />
                                                               <Style.Triggers>
                                                                   <MultiDataTrigger>
                                                                       <MultiDataTrigger.Conditions>
                                                                           <Condition Binding="{Binding IsArchived}" Value="True" />
                                                                           <Condition Binding="{Binding Task.IsConversationMutationPending}" Value="True" />
                                                                       </MultiDataTrigger.Conditions>
                                                                       <Setter Property="Visibility" Value="Visible" />
                                                                   </MultiDataTrigger>
                                                               </Style.Triggers>
                                                           </Style>
                                                       </TextBlock.Style>
                                                       <TextBlock.ToolTip>
                                                           <TextBlock Text="{Binding [Tasks.MutationPending], Source={StaticResource Loc}}" />
                                                       </TextBlock.ToolTip>
                                                   </TextBlock>
                                               </Grid>

                                             <Button x:Name="ProjectEntry"
                                                      Grid.ColumnSpan="2"
                                                     AutomationProperties.AutomationId="ConversationNavigationProjectEntry"
                                                     AutomationProperties.Name="{Binding Title}"
                                                     Command="{Binding DataContext.OpenConversationGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding}"
                                                     HorizontalContentAlignment="Stretch"
                                                     Style="{StaticResource BaseButtonStyle}"
                                                     Padding="10,7"
                                                     Margin="0,2"
                                                     Background="Transparent"
                                                     BorderBrush="Transparent"
                                                     BorderThickness="1"
                                                     MinHeight="42">
                                                 <Grid>
                                                     <Grid.ColumnDefinitions>
                                                         <ColumnDefinition Width="24" />
                                                         <ColumnDefinition Width="*" />
                                                         <ColumnDefinition Width="Auto" />
                                                         <ColumnDefinition Width="18" />
                                                     </Grid.ColumnDefinitions>
                                                     <TextBlock Grid.Column="0"
                                                                Text="&#xE8B7;"
                                                                FontFamily="{StaticResource IconFont}"
                                                                FontSize="15"
                                                                Foreground="{DynamicResource InkMutedBrush}"
                                                                VerticalAlignment="Center" />
                                                     <TextBlock Grid.Column="1"
                                                                Text="{Binding Title}"
                                                                FontSize="12.5"
                                                                FontWeight="SemiBold"
                                                                VerticalAlignment="Center"
                                                                TextTrimming="CharacterEllipsis" />
                                                     <TextBlock Grid.Column="2"
                                                                Text="{Binding Count}"
                                                                Margin="8,0,10,0"
                                                                Foreground="{DynamicResource InkSubtleBrush}"
                                                                FontSize="10.5"
                                                                VerticalAlignment="Center" />
                                                     <TextBlock Grid.Column="3"
                                                                Text="&#xE76C;"
                                                                FontFamily="{StaticResource IconFont}"
                                                                Foreground="{DynamicResource InkSubtleBrush}"
                                                                VerticalAlignment="Center" />
                                                 </Grid>
                                             </Button>
                                         </Grid>
                                             <DataTemplate.Triggers>
                                             <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                                 <Setter TargetName="SectionEntry" Property="Visibility" Value="Visible" />
                                                 <Setter TargetName="ConversationEntry" Property="Visibility" Value="Collapsed" />
                                                 <Setter TargetName="ProjectEntry" Property="Visibility" Value="Collapsed" />
                                             </DataTrigger>
                                             <DataTrigger Binding="{Binding IsConversation}" Value="True">
                                                 <Setter TargetName="SectionEntry" Property="Visibility" Value="Collapsed" />
                                                 <Setter TargetName="ConversationEntry" Property="Visibility" Value="Visible" />
                                                 <Setter TargetName="ProjectEntry" Property="Visibility" Value="Collapsed" />
                                             </DataTrigger>
                                             <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                 <Setter TargetName="ConversationEntry" Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
                                                 <Setter TargetName="ConversationStatusSpine" Property="Background" Value="{DynamicResource GreenBrush}" />
                                             </DataTrigger>
                                             <DataTrigger Binding="{Binding IsProject}" Value="True">
                                                 <Setter TargetName="SectionEntry" Property="Visibility" Value="Collapsed" />
                                                 <Setter TargetName="ConversationEntry" Property="Visibility" Value="Collapsed" />
                                                 <Setter TargetName="ProjectEntry" Property="Visibility" Value="Visible" />
                                             </DataTrigger>
                                             <DataTrigger Binding="{Binding Task.IsRunningNow}" Value="True">
                                                 <Setter TargetName="ConversationEntry" Property="BorderBrush" Value="{DynamicResource YellowBrush}" />
                                                 <Setter TargetName="ConversationStatusSpine" Property="Background" Value="{DynamicResource YellowBrush}" />
                                             </DataTrigger>
                                         </DataTemplate.Triggers>
                                     </DataTemplate>
                                 </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <ListBox x:Name="TaskList"
                                 AutomationProperties.AutomationId="ConversationIndex"
                                 AutomationProperties.Name="{Binding [Shell.Conversations], Source={StaticResource Loc}}"
                                 PreviewMouseWheel="ConversationList_PreviewMouseWheel"
                                 ItemsSource="{Binding TasksView}"
                                 SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                                 Padding="0,5,0,12"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ConversationListItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.IsDeferredScrollingEnabled="False"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConversationNavigationDetail}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="82">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0"
                                                AutomationProperties.AutomationId="ConversationDragGripButton"
                                                AutomationProperties.Name="{Binding [Tasks.DragHandle], Source={StaticResource Loc}}"
                                                Style="{StaticResource ConversationDragGripButtonStyle}"
                                                ToolTip="{Binding [Tasks.DragHandle], Source={StaticResource Loc}}"
                                                PreviewMouseLeftButtonDown="ConversationDragGrip_PreviewMouseLeftButtonDown"
                                                LostMouseCapture="ConversationDragGrip_LostMouseCapture"
                                                PreviewKeyDown="ConversationDragGrip_PreviewKeyDown" />

                                        <Grid Grid.Column="1"
                                              Margin="8,11,4,11">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1"
                                                        AutomationProperties.AutomationId="ConversationPinButton"
                                                        AutomationProperties.Name="{Binding PinActionText}"
                                                        Command="{Binding DataContext.ToggleConversationPinCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Width="24"
                                                        Height="24"
                                                        MinHeight="24"
                                                        Margin="4,-4,0,-4"
                                                        Style="{StaticResource CompactIconButtonStyle}"
                                                        ToolTip="{Binding PinActionText}">
                                                    <TextBlock FontFamily="{StaticResource IconFont}"
                                                               FontSize="11"
                                                               Text="&#xE718;">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
                                                                <Setter Property="Opacity" Value="0.58" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SignatureBrush}" />
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding UpdatedText}"
                                                           Margin="8,0,0,0"
                                                           Foreground="{DynamicResource InkSubtleBrush}"
                                                           FontSize="10" />
                                            </Grid>
                                            <StackPanel Grid.Row="1"
                                                        Margin="0,4,0,0"
                                                        Orientation="Horizontal">
                                                <controls:ActivitySpinner Margin="0,0,6,0"
                                                                          VerticalAlignment="Center"
                                                                          IsActive="{Binding IsRunningSpinnerVisible}"
                                                                          Visibility="{Binding IsRunningSpinnerVisible, Converter={StaticResource BoolToVisibility}}" />
                                                <Border Margin="0,0,6,0"
                                                        Padding="5,0,5,1"
                                                        MinWidth="18"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource YellowSoftBrush}"
                                                        BorderBrush="{DynamicResource YellowBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        ToolTip="{Binding [Tasks.RetryingHint], Source={StaticResource Loc}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRetryCountVisible}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding RetryCountText}"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource YellowBrush}"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </Border>
                                                 <TextBlock Text="{Binding HealthText}"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <Border Margin="8,0,0,0"
                                                        Padding="7,2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                                        CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ProjectName}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding ProjectName}"
                                                               Foreground="{DynamicResource InkSubtleBrush}"
                                                               FontSize="9"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Border>
                                            </StackPanel>
                                             <TextBlock Grid.Row="2"
                                                        Text="{Binding Preview}"
                                                        Margin="0,4,0,0"
                                                        Foreground="{DynamicResource InkMutedBrush}"
                                                        FontSize="11"
                                                        TextWrapping="NoWrap"
                                                        TextTrimming="CharacterEllipsis" />
                                        </Grid>

                                        <CheckBox Grid.Column="2"
                                                  AutomationProperties.AutomationId="ConversationCardProtectionToggle"
                                                  AutomationProperties.Name="{Binding [Tasks.Enabled], Source={StaticResource Loc}}"
                                                  AutomationProperties.HelpText="{Binding [Tasks.ToggleHint], Source={StaticResource Loc}}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggleProtection}"
                                                  Margin="0,9,8,0"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Top"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  ToolTip="{Binding [Tasks.Enabled], Source={StaticResource Loc}}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleCheckStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>

                                        <Button Grid.Column="2"
                                                AutomationProperties.AutomationId="TaskFollowUpEntryButton"
                                                AutomationProperties.Name="{Binding FollowUpQueueActionText}"
                                                AutomationProperties.HelpText="{Binding FollowUpQueueStatusText}"
                                                Command="{Binding DataContext.OpenFollowUpEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="34"
                                                Height="34"
                                                MinHeight="34"
                                                Margin="0,0,10,8"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                ToolTip="{Binding [FollowUp.OpenQueueShort], Source={StaticResource Loc}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArchived}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Grid Width="22" Height="22">
                                                <StackPanel Margin="3,5,7,3"
                                                            VerticalAlignment="Center">
                                                    <Rectangle Height="2"
                                                               Margin="0,0,0,2"
                                                               Fill="{DynamicResource InkMutedBrush}"
                                                               RadiusX="1"
                                                               RadiusY="1" />
                                                    <Rectangle Height="2"
                                                               Margin="3,0,0,2"
                                                               Fill="{DynamicResource InkMutedBrush}"
                                                               RadiusX="1"
                                                               RadiusY="1" />
                                                    <Rectangle Height="2"
                                                               Margin="6,0,0,0"
                                                               Fill="{DynamicResource InkMutedBrush}"
                                                               RadiusX="1"
                                                               RadiusY="1" />
                                                </StackPanel>
                                                <Border MinWidth="14"
                                                        Height="15"
                                                        Padding="3,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        CornerRadius="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FollowUpMessageCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Absent}">
                                                                    <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                                                                    <Setter Property="Opacity" Value="0.72" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Blocked}">
                                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Uncertain}">
                                                                    <Setter Property="Background" Value="{DynamicResource OrangeBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding FollowUpMessageCount}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="White"
                                                               FontSize="10"
                                                               FontWeight="Bold" />
                                                </Border>
                                                <TextBlock HorizontalAlignment="Right"
                                                           VerticalAlignment="Bottom"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource SignatureBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Scheduled}">
                                                                    <Setter Property="Text" Value="&#xE823;" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Paused}">
                                                                    <Setter Property="Text" Value="&#xE769;" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Blocked}">
                                                                    <Setter Property="Text" Value="&#xE7BA;" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Uncertain}">
                                                                    <Setter Property="Text" Value="&#xE9CE;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>

                                        <Grid Grid.Column="2"
                                              Margin="2,0,8,0"
                                              VerticalAlignment="Center"
                                              ToolTip="{Binding ConversationMutationStatusText}"
                                              AutomationProperties.HelpText="{Binding ConversationMutationStatusText}">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsArchived}" Value="True" />
                                                                    <Condition Binding="{Binding IsConversationMutationPending}" Value="False" />
                                                                    <Condition Binding="{Binding IsDeleteConfirmationOpen}" Value="False" />
                                                                    <Condition Binding="{Binding IsConversationMutationUnavailable}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button AutomationProperties.AutomationId="ArchivedConversationUnarchiveButton"
                                                        AutomationProperties.Name="{Binding [Tasks.Unarchive], Source={StaticResource Loc}}"
                                                        AutomationProperties.HelpText="{Binding UnarchiveActionHint}"
                                                        Width="30"
                                                        Height="30"
                                                        MinHeight="30"
                                                        Style="{StaticResource CompactIconButtonStyle}"
                                                        Command="{Binding DataContext.UnarchiveConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="{Binding UnarchiveActionHint}">
                                                    <TextBlock Text="&#xE72B;"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="13" />
                                                </Button>
                                                <Button AutomationProperties.AutomationId="ArchivedConversationDeleteButton"
                                                        AutomationProperties.Name="{Binding [Tasks.Delete], Source={StaticResource Loc}}"
                                                        AutomationProperties.HelpText="{Binding DeleteActionHint}"
                                                        Width="30"
                                                        Height="30"
                                                        MinHeight="30"
                                                        Margin="4,0,0,0"
                                                        Style="{StaticResource DangerIconButtonStyle}"
                                                        Command="{Binding DataContext.RequestDeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTipService.ShowOnDisabled="True"
                                                        ToolTip="{Binding DeleteActionHint}">
                                                    <TextBlock Text="&#xE74D;"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsArchived}" Value="True" />
                                                                    <Condition Binding="{Binding IsDeleteConfirmationOpen}" Value="True" />
                                                                    <Condition Binding="{Binding IsConversationMutationPending}" Value="False" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Button AutomationProperties.AutomationId="ArchivedConversationDeleteConfirmButton"
                                                        AutomationProperties.Name="{Binding [Tasks.DeleteConfirm], Source={StaticResource Loc}}"
                                                        Width="30"
                                                        Height="30"
                                                        MinHeight="30"
                                                        Style="{StaticResource DangerIconButtonStyle}"
                                                        Command="{Binding DataContext.ConfirmDeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding [Tasks.DeleteConfirm], Source={StaticResource Loc}}">
                                                    <TextBlock Text="&#xE73E;"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                </Button>
                                                <Button AutomationProperties.AutomationId="ArchivedConversationDeleteCancelButton"
                                                        AutomationProperties.Name="{Binding [Tasks.DeleteCancel], Source={StaticResource Loc}}"
                                                        Width="30"
                                                        Height="30"
                                                        MinHeight="30"
                                                        Margin="4,0,0,0"
                                                        Style="{StaticResource CompactIconButtonStyle}"
                                                        Command="{Binding DataContext.CancelDeleteConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding [Tasks.DeleteCancel], Source={StaticResource Loc}}">
                                                    <TextBlock Text="&#xE711;"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="13" />
                                                </Button>
                                            </StackPanel>

                                            <TextBlock AutomationProperties.AutomationId="ArchivedConversationMutationProgress"
                                                       AutomationProperties.Name="{Binding [Tasks.MutationPending], Source={StaticResource Loc}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="14"
                                                       Text="&#xE895;">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsArchived}" Value="True" />
                                                                    <Condition Binding="{Binding IsConversationMutationPending}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <TextBlock.ToolTip>
                                                    <TextBlock Text="{Binding [Tasks.MutationPending], Source={StaticResource Loc}}" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>

                                            <Border Width="7"
                                                    Height="7"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="0,3,3,0"
                                                    Background="{DynamicResource DangerBrush}"
                                                    CornerRadius="4"
                                                    IsHitTestVisible="False">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasConversationMutationStatus}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </Grid>

                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="260"
                                    IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasVisibleTasks}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE8BD;"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="22"
                                       Foreground="{DynamicResource InkSubtleBrush}" />
                            <TextBlock Text="{Binding TaskEmptyTitleText}"
                                       Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <Button Command="{Binding ClearTaskSearchCommand}"
                                    AutomationProperties.AutomationId="ConversationEmptyClearSearchButton"
                                    AutomationProperties.Name="{Binding [Tasks.ClearSearch], Source={StaticResource Loc}}"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0"
                                    Padding="10,4"
                                    MinHeight="28"
                                    IsHitTestVisible="True"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    ToolTip="{Binding [Tasks.ClearSearch], Source={StaticResource Loc}}">
                                <Button.Visibility>
                                    <Binding Path="HasTaskSearchText">
                                        <Binding.Converter>
                                            <BooleanToVisibilityConverter />
                                        </Binding.Converter>
                                    </Binding>
                                </Button.Visibility>
                                <TextBlock Text="{Binding [Tasks.ClearSearch], Source={StaticResource Loc}}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Conversation inspector -->
                <Border x:Name="TasksWorkbenchPane"
                        Grid.Column="1"
                        Background="Transparent"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedTask}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="92" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="TaskWorkbenchHeaderStage"
                                    Background="{DynamicResource GlassSurfaceStrongBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid Margin="26,0,22,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedTask.Name}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Margin="0,8,0,0"
                                                    Orientation="Horizontal">
                                            <Border Padding="8,3"
                                                    Background="{DynamicResource GlassSurfaceBrush}"
                                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Margin="0,0,7,0"
                                                             VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.Processing}">
                                                                        <Setter Property="Fill" Value="{DynamicResource BlueBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.Recovering}">
                                                                        <Setter Property="Fill" Value="{DynamicResource BlueBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.NeedsAttention}">
                                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.ManualReview}">
                                                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.WaitingForIdle}">
                                                                        <Setter Property="Fill" Value="{DynamicResource OrangeBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.WaitingForDesktop}">
                                                                        <Setter Property="Fill" Value="{DynamicResource OrangeBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.CoolingDown}">
                                                                        <Setter Property="Fill" Value="{DynamicResource OrangeBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.Unknown}">
                                                                        <Setter Property="Fill" Value="{DynamicResource InkSubtleBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.NoHistory}">
                                                                        <Setter Property="Fill" Value="{DynamicResource InkSubtleBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding SelectedTask.Health}" Value="{x:Static models:TaskHealth.Paused}">
                                                                        <Setter Property="Fill" Value="{DynamicResource InkSubtleBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding SelectedTask.HealthText}"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding SelectedTask.UpdatedText}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource MonoTextStyle}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            AutomationProperties.AutomationId="InspectorFollowUpEntryButton"
                                            AutomationProperties.Name="{Binding SelectedTask.FollowUpQueueActionText}"
                                            Command="{Binding OpenFollowUpEditorCommand}"
                                            CommandParameter="{Binding SelectedTask}"
                                            MaxWidth="320"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            ToolTip="{Binding [FollowUp.OpenQueueShort], Source={StaticResource Loc}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8FD;"
                                                       Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       FontFamily="{StaticResource IconFont}"
                                                       FontSize="13"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" />
                                            <TextBlock Text="{Binding SelectedTask.FollowUpQueueActionText}"
                                                       MaxWidth="240"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border MinWidth="18"
                                                    Height="18"
                                                    Margin="8,0,0,0"
                                                    Padding="4,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource PrimaryBrush}"
                                                    CornerRadius="9">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedTask.FollowUpMessageCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedTask.FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Absent}">
                                                                <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                                                                <Setter Property="Opacity" Value="0.72" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedTask.FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Blocked}">
                                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedTask.FollowUpQueueState}" Value="{x:Static models:FollowUpQueueVisualState.Uncertain}">
                                                                <Setter Property="Background" Value="{DynamicResource OrangeBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SelectedTask.FollowUpMessageCount}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="White"
                                                           FontSize="10"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer x:Name="TaskWorkbenchContentStage"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <Grid Margin="26,22,24,28">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="4*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <Border Padding="20"
                                                Background="{DynamicResource GlassSurfaceBrush}"
                                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding [Shell.CurrentState], Source={StaticResource Loc}}"
                                                           Style="{StaticResource SectionHeaderStyle}" />
                                                <TextBlock Text="{Binding SelectedTask.StatusText}"
                                                           Margin="0,13,0,0"
                                                           FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           MaxHeight="60"
                                                           TextWrapping="Wrap" />
                                                <!-- The conversation's own last message is labelled rather than
                                                     left bare under the status line: unlabelled, it read as part
                                                     of the state description instead of as quoted content. -->
                                                <TextBlock Text="{Binding [Shell.LastReply], Source={StaticResource Loc}}"
                                                           Margin="0,16,0,0"
                                                           Style="{StaticResource SectionHeaderStyle}" />
                                                <Border Margin="0,7,0,0"
                                                        Padding="11,8"
                                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="2,0,0,0"
                                                        CornerRadius="0,5,5,0">
                                                    <TextBlock Text="{Binding SelectedTask.Preview}"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               FontSize="12"
                                                               LineHeight="18"
                                                               MaxHeight="54"
                                                               TextTrimming="CharacterEllipsis"
                                                               TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Margin="0,24,0,0"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,1,0,0">
                                            <StackPanel Margin="0,18,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding [Shell.RecoveryHistory], Source={StaticResource Loc}}"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource SectionHeaderStyle}" />
                                                    <!-- The all-time tally belongs next to the history it counts.
                                                         It used to sit in the right column one line above the
                                                         current failure's attempt count, where two numbers of
                                                         different units read as comparable. -->
                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <TextBlock AutomationProperties.AutomationId="TaskRecoveryLedgerValue"
                                                                   Text="{Binding SelectedTask.RecoveryLedger.ConfirmedDispatches}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding [Tasks.LedgerTotalUnit], Source={StaticResource Loc}}"
                                                                   Margin="5,0,0,1"
                                                                   VerticalAlignment="Bottom"
                                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                                   FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,14,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="1"
                                                            Margin="4,9,0,0"
                                                            HorizontalAlignment="Left"
                                                            Background="{DynamicResource BorderStrongBrush}" />
                                                    <Ellipse Width="9"
                                                             Height="9"
                                                             HorizontalAlignment="Left"
                                                             VerticalAlignment="Top"
                                                             Fill="{DynamicResource PrimaryBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding SelectedTask.LastEvent}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   MaxHeight="52"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,7,0,0"
                                                                   AutomationProperties.AutomationId="TaskRecoveryLedgerText"
                                                                   Text="{Binding SelectedTask.RecoveryLedgerText}"
                                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   LineHeight="17"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Visibility>
                                                                <Binding Path="SelectedTask.HasRecoveryLedgerText">
                                                                    <Binding.Converter>
                                                                        <BooleanToVisibilityConverter />
                                                                    </Binding.Converter>
                                                                </Binding>
                                                            </TextBlock.Visibility>
                                                        </TextBlock>
                                                        <!-- Says so out loud when the tally is zero. A bare 0 next
                                                             to the section title reads as a missing value rather
                                                             than as "nothing has needed resending". -->
                                                        <TextBlock Text="{Binding [Shell.LedgerEmpty], Source={StaticResource Loc}}"
                                                                   Margin="0,7,0,0"
                                                                   Foreground="{DynamicResource InkSubtleBrush}"
                                                                   FontSize="11"
                                                                   LineHeight="17"
                                                                   TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedTask.HasRecoveryLedgerText}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding SelectedTask.ObservationText}"
                                                                   Margin="0,8,0,0"
                                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                                   FontSize="11"
                                                                   LineHeight="17"
                                                                   MaxHeight="72"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="{Binding [Shell.Origin], Source={StaticResource Loc}}"
                                                   Margin="0,26,0,0"
                                                   Style="{StaticResource SectionHeaderStyle}" />
                                        <Border Margin="0,10,0,0"
                                                Padding="16"
                                                Background="{DynamicResource SurfaceSubtleBrush}"
                                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Tasks.Source], Source={StaticResource Loc}}"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding SelectedTask.Source}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,10,0,0"
                                                           Text="{Binding [Tasks.WorkingDirectory], Source={StaticResource Loc}}"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="1"
                                                           Margin="0,10,0,0"
                                                           Text="{Binding SelectedTask.Cwd}"
                                                           Style="{StaticResource MonoTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="2"
                                                           Margin="0,10,0,0"
                                                           Text="{Binding [Tasks.LatestTurn], Source={StaticResource Loc}}"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Grid.Row="2"
                                                           Grid.Column="1"
                                                           Margin="0,10,0,0"
                                                           Text="{Binding SelectedTask.LatestTurnText}"
                                                           Style="{StaticResource MonoTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Margin="26,0,0,0"
                                            Padding="18"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource GlassSurfaceStrongBrush}"
                                            BorderBrush="{DynamicResource GlassBorderBrush}"
                                            BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Shell.Protection], Source={StaticResource Loc}}"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource SectionHeaderStyle}" />
                                                <CheckBox Grid.Column="1"
                                                          AutomationProperties.AutomationId="ConversationProtectionToggle"
                                                          AutomationProperties.Name="{Binding [Mode.Title], Source={StaticResource Loc}}"
                                                          IsChecked="{Binding SelectedTask.IsEnabled, Mode=TwoWay}"
                                                          IsEnabled="{Binding SelectedTask.CanToggleProtection}"
                                                          VerticalAlignment="Center"
                                                          Style="{StaticResource ToggleCheckStyle}"
                                                          ToolTip="{Binding [Mode.Title], Source={StaticResource Loc}}" />
                                            </Grid>
                                            <StackPanel Margin="0,12,0,0"
                                                        Orientation="Horizontal">
                                                <Ellipse Width="8"
                                                         Height="8"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="{DynamicResource OrangeBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTask.ProtectionText}" Value="">
                                                                    <Setter Property="Fill" Value="{DynamicResource GreenBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedTask.IsArchived}" Value="True">
                                                                    <Setter Property="Fill" Value="{DynamicResource InkSubtleBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding SelectedTask.ProtectionText}"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           FontSize="11"
                                                           MaxHeight="54"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTask.ProtectionText}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding [Value.Ready], Source={StaticResource Loc}}"
                                                           Foreground="{DynamicResource InkBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedTask.ProtectionText}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Margin="0,18,0,0"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,1,0,0" />
                                            <TextBlock Text="{Binding [Shell.MessageSequence], Source={StaticResource Loc}}"
                                                       Margin="0,16,0,0"
                                                       Style="{StaticResource SectionHeaderStyle}" />
                                            <TextBlock Text="{Binding SelectedTask.FollowUpQueueStatusText}"
                                                       Margin="0,9,0,0"
                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                       FontSize="11"
                                                       LineHeight="17"
                                                       MaxHeight="54"
                                                       TextWrapping="Wrap" />

                                            <Border Margin="0,18,0,0"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,1,0,0" />
                                            <TextBlock Text="{Binding [Shell.GuardianAction], Source={StaticResource Loc}}"
                                                       Margin="0,16,0,0"
                                                       Style="{StaticResource SectionHeaderStyle}" />
                                            <Grid Margin="0,12,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding [Tasks.NextAttempt], Source={StaticResource Loc}}"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           FontSize="11" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="12,0,0,0"
                                                           Text="{Binding SelectedTask.NextAttemptText}"
                                                           FontFamily="Cascadia Mono, Consolas"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- Zero-height on purpose: it must stay Visible so an
                                                     automation peer exists, but it is not part of the
                                                     visual design. It lets a probe prove which thread the
                                                     panel is actually showing. -->
                                                <TextBlock Grid.Column="1"
                                                           Height="0"
                                                           AutomationProperties.AutomationId="TaskDiagnosticReference"
                                                           Text="{Binding SelectedTask.DiagnosticReference}"
                                                           Foreground="Transparent"
                                                           FontSize="1" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,11,0,0"
                                                           Text="{Binding [Tasks.Attempts], Source={StaticResource Loc}}"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           FontSize="11" />
                                                <StackPanel Grid.Row="1"
                                                            Grid.Column="1"
                                                            Margin="12,11,0,0"
                                                            Orientation="Horizontal">
                                                    <TextBlock AutomationProperties.AutomationId="TaskAttemptsValue"
                                                               Text="{Binding SelectedTask.Attempts}"
                                                               FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="11"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding [Tasks.AttemptsUnit], Source={StaticResource Loc}}"
                                                               Margin="4,0,0,0"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               FontSize="10"
                                                               VerticalAlignment="Bottom" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    MaxWidth="320">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedTask}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE8A5;"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="22"
                                       Foreground="{DynamicResource InkSubtleBrush}" />
                            <TextBlock Text="{Binding [Shell.NoSelection], Source={StaticResource Loc}}"
                                       Margin="0,14,0,0"
                                       HorizontalAlignment="Center"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Preset-message second-level workspace -->
            <Grid x:Name="FollowUpEditor"
                  AllowDrop="True"
                  PreviewDragOver="FollowUpEditor_PreviewDragOver"
                  PreviewDrop="FollowUpEditor_PreviewDrop"
                  Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFollowUpDetailPage}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- The route header carries identity and actions; it is never a footer dock. -->
                <Grid x:Name="FollowUpRouteHeader"
                      Grid.Row="0"
                      Margin="20,0"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="FollowUpBackButton"
                            AutomationProperties.AutomationId="FollowUpBackButton"
                            AutomationProperties.Name="{Binding [FollowUp.BackToTasks], Source={StaticResource Loc}}"
                            Command="{Binding BackToTasksCommand}"
                            Margin="0,0,12,0"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{Binding [FollowUp.BackToTasks], Source={StaticResource Loc}}">
                        <TextBlock Text="&#xE72B;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14" />
                    </Button>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedTaskFollowUpTitle}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,3,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnsavedFollowUpChanges}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Ellipse Width="6"
                                     Height="6"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource PrimaryBrush}" />
                            <TextBlock AutomationProperties.LiveSetting="Polite"
                                       Text="{Binding FollowUpEditorStatus}"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       FontSize="10"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox AutomationProperties.AutomationId="FollowUpQueueEnabledToggle"
                                  AutomationProperties.Name="{Binding [FollowUp.QueueEnabled], Source={StaticResource Loc}}"
                                  IsChecked="{Binding SelectedFollowUpsEnabled, Mode=TwoWay}"
                                  IsEnabled="{Binding CanEditSelectedFollowUps}"
                                  Style="{StaticResource ToggleCheckStyle}"
                                  ToolTip="{Binding [FollowUp.QueueEnabled], Source={StaticResource Loc}}" />
                        <Button AutomationProperties.AutomationId="FollowUpAddMessageButton"
                                AutomationProperties.Name="{Binding [FollowUp.Add], Source={StaticResource Loc}}"
                                Command="{Binding AddFollowUpMessageCommand}"
                                Margin="10,0,0,0"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{Binding [FollowUp.Add], Source={StaticResource Loc}}">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="15" />
                        </Button>
                        <Border x:Name="FollowUpSaveDock"
                                AutomationProperties.AutomationId="FollowUpSaveDock"
                                Margin="8,0,0,0">
                            <Button AutomationProperties.AutomationId="FollowUpSaveButton"
                                    AutomationProperties.Name="{Binding [FollowUp.Save], Source={StaticResource Loc}}"
                                    Command="{Binding SaveFollowUpMessagesCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTip="{Binding [FollowUp.Save], Source={StaticResource Loc}}">
                                <TextBlock Text="&#xE74E;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="15" />
                            </Button>
                        </Border>
                    </StackPanel>
                    <Border Grid.ColumnSpan="3"
                            VerticalAlignment="Bottom"
                            Height="1"
                            Background="{DynamicResource BorderBrush}" />
                </Grid>

                <!-- One continuous, full-width queue timeline. -->
                <Grid x:Name="FollowUpMessageTimeline"
                      Grid.Row="1"
                      Margin="20,12,20,18"
                      AutomationProperties.AutomationId="FollowUpMessageEditorRegion"
                      RenderTransformOrigin="0.5,0">
                    <Grid.RenderTransform>
                        <TranslateTransform />
                    </Grid.RenderTransform>
                    <ListBox x:Name="FollowUpMessageList"
                             AutomationProperties.AutomationId="FollowUpMessageList"
                             AutomationProperties.Name="{Binding [FollowUp.QueueTitle], Source={StaticResource Loc}}"
                             ItemsSource="{Binding FollowUpMessages}"
                             SelectedItem="{Binding SelectedFollowUpMessage, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,0,0,4"
                             HorizontalContentAlignment="Stretch"
                             ItemContainerStyle="{StaticResource FollowUpListItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch">
                                    <Border Height="4"
                                            Margin="12,-2,12,0"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource PrimaryBrush}"
                                            CornerRadius="2"
                                            Panel.ZIndex="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDropBefore}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Border Height="4"
                                            Margin="12,0,12,0"
                                            VerticalAlignment="Bottom"
                                            Background="{DynamicResource PrimaryBrush}"
                                            CornerRadius="2"
                                            Panel.ZIndex="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDropAfter}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border AutomationProperties.AutomationId="FollowUpMessageCardSurface"
                                            MinHeight="64"
                                            Margin="0,3"
                                            Padding="8"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                                        <Setter Property="Opacity" Value="0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0"
                                                    AutomationProperties.AutomationId="FollowUpDragGripButton"
                                                    AutomationProperties.Name="{Binding [FollowUp.DragHandle], Source={StaticResource Loc}}"
                                                    Width="38"
                                                    Height="48"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Top"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Foreground="{DynamicResource InkSubtleBrush}"
                                                    FocusVisualStyle="{x:Null}"
                                                    ToolTip="{Binding [FollowUp.DragHandle], Source={StaticResource Loc}}"
                                                    PreviewMouseLeftButtonDown="FollowUpDragGrip_PreviewMouseLeftButtonDown"
                                                    LostMouseCapture="FollowUpDragGrip_LostMouseCapture"
                                                    PreviewKeyDown="FollowUpDragGrip_PreviewKeyDown">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Grid Background="Transparent"
                                                              RenderTransformOrigin="0.5,0.5">
                                                            <Grid.RenderTransform>
                                                                <ScaleTransform x:Name="GripScale" />
                                                            </Grid.RenderTransform>
                                                            <Border x:Name="GripHoverSurface"
                                                                    Width="30"
                                                                    Height="30"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource ControlHoverBrush}"
                                                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Opacity="0" />
                                                            <Border x:Name="GripPressedSurface"
                                                                    Width="30"
                                                                    Height="30"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource PrimarySoftBrush}"
                                                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="6"
                                                                    Opacity="0" />
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center" />
                                                            <Border x:Name="GripFocusSurface"
                                                                    Width="32"
                                                                    Height="32"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                                                    BorderThickness="2"
                                                                    CornerRadius="7"
                                                                    IsHitTestVisible="False"
                                                                    Opacity="0" />
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="GripHoverSurface"
                                                                                             Storyboard.TargetProperty="Opacity"
                                                                                             To="1"
                                                                                             Duration="0:0:0.16">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="GripHoverSurface"
                                                                                             Storyboard.TargetProperty="Opacity"
                                                                                             To="0"
                                                                                             Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="GripPressedSurface"
                                                                                             Storyboard.TargetProperty="Opacity"
                                                                                             To="1"
                                                                                             Duration="0:0:0.15">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="GripScale"
                                                                                             Storyboard.TargetProperty="ScaleX"
                                                                                             To="0.94"
                                                                                             Duration="0:0:0.15">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="GripScale"
                                                                                             Storyboard.TargetProperty="ScaleY"
                                                                                             To="0.94"
                                                                                             Duration="0:0:0.15">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                                <Trigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="GripPressedSurface"
                                                                                             Storyboard.TargetProperty="Opacity"
                                                                                             To="0"
                                                                                             Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="GripScale"
                                                                                             Storyboard.TargetProperty="ScaleX"
                                                                                             To="1"
                                                                                             Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="GripScale"
                                                                                             Storyboard.TargetProperty="ScaleY"
                                                                                             To="1"
                                                                                             Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.ExitActions>
                                                            </Trigger>
                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                <Setter TargetName="GripFocusSurface" Property="Opacity" Value="1" />
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid Width="14" Height="20">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Ellipse Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        <Ellipse Grid.Column="1" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        <Ellipse Grid.Row="1" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        <Ellipse Grid.Row="1" Grid.Column="1" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        <Ellipse Grid.Row="2" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        <Ellipse Grid.Row="2" Grid.Column="1" Width="4" Height="4" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Grid>
                                            </Button>

                                            <Grid Grid.Column="1"
                                                  MinHeight="48"
                                                  Margin="8,0,10,0"
                                                  VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding ContentPreview}"
                                                           ToolTip="{Binding ContentPreview}"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           TextTrimming="CharacterEllipsis" />

                                                <StackPanel Grid.Row="1"
                                                            Margin="0,5,0,0"
                                                            Orientation="Horizontal">
                                                    <Grid VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UseWorkflowAutomation}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding [FollowUp.TriggerCompletion], Source={StaticResource Loc}}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsScheduled}" Value="True">
                                                                                <Setter Property="Text" Value="{Binding ScheduleSummary}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <Ellipse Width="3"
                                                                     Height="3"
                                                                     Margin="9,0"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{DynamicResource InkSubtleBrush}" />
                                                            <TextBlock Text="{Binding [FollowUp.RetryShort], Source={StaticResource Loc}}"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                                       FontSize="11" />
                                                            <TextBlock Margin="4,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding EffectiveMaximumErrorRetries}" />
                                                                        <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasValidMaximumErrorRetries}" Value="False">
                                                                                <Setter Property="Text" Value="{Binding MaximumErrorRetriesText}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </StackPanel>

                                                        <StackPanel Orientation="Horizontal">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding UseWorkflowAutomation}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <Border Padding="7,2"
                                                                    Background="{DynamicResource PrimarySoftBrush}"
                                                                    CornerRadius="7">
                                                                <TextBlock Text="{Binding WorkflowTriggerText}"
                                                                           MaxWidth="210"
                                                                           Foreground="{DynamicResource PrimaryBrush}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <TextBlock Text="&#xE72A;"
                                                                       Margin="7,0"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="{StaticResource IconFont}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource InkSubtleBrush}" />
                                                            <Border Padding="7,2"
                                                                    Background="{DynamicResource SurfaceSubtleBrush}"
                                                                    CornerRadius="7">
                                                                <TextBlock Text="{Binding WorkflowDestinationText}"
                                                                           MaxWidth="150"
                                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                            <TextBlock Text="{Binding WorkflowActionText}"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource InkMutedBrush}"
                                                                       FontSize="10" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <Border Margin="9,0,0,0"
                                                            Padding="6,2"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource PrimarySoftBrush}"
                                                            CornerRadius="6"
                                                            ToolTip="{Binding AttachmentLimitStatus}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE723;"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="{StaticResource IconFont}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                                            <TextBlock Text="{Binding AttachmentCount}"
                                                                       Margin="4,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource PrimaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                <Button AutomationProperties.AutomationId="FollowUpEditMessageButton"
                                                        AutomationProperties.Name="{Binding [FollowUp.Edit], Source={StaticResource Loc}}"
                                                        Command="{Binding DataContext.EditFollowUpMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding [FollowUp.Edit], Source={StaticResource Loc}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="&#xE70F;"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="13" />
                                                </Button>
                                                <Button AutomationProperties.AutomationId="FollowUpDoneEditingButton"
                                                        AutomationProperties.Name="{Binding [FollowUp.DoneEditing], Source={StaticResource Loc}}"
                                                        Command="{Binding DataContext.CloseFollowUpMessageEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="{Binding [FollowUp.DoneEditing], Source={StaticResource Loc}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CompactIconButtonStyle}">
                                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="&#xE73E;"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="13" />
                                                </Button>
                                                <Button AutomationProperties.AutomationId="FollowUpRemoveMessageButton"
                                                        AutomationProperties.Name="{Binding [FollowUp.Remove], Source={StaticResource Loc}}"
                                                        Command="{Binding DataContext.RemoveFollowUpMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Width="30"
                                                        Height="30"
                                                        MinHeight="30"
                                                        Style="{StaticResource DangerIconButtonStyle}"
                                                        ToolTip="{Binding [FollowUp.Remove], Source={StaticResource Loc}}">
                                                    <TextBlock Text="&#xE74D;"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                </Button>
                                                <CheckBox AutomationProperties.AutomationId="FollowUpMessageEnabledToggle"
                                                          AutomationProperties.Name="{Binding [FollowUp.MessageEnabled], Source={StaticResource Loc}}"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Margin="6,0,2,0"
                                                          Style="{StaticResource ToggleCheckStyle}"
                                                          ToolTip="{Binding [FollowUp.MessageEnabled], Source={StaticResource Loc}}" />
                                            </StackPanel>

                                            <Grid Grid.Row="1"
                                                  Grid.Column="1"
                                                  Grid.ColumnSpan="2"
                                                  Margin="8,10,2,3">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBox AutomationProperties.AutomationId="FollowUpMessageTextBox"
                                                         AutomationProperties.Name="{Binding [FollowUp.MessagePlaceholder], Source={StaticResource Loc}}"
                                                         Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="62"
                                                         MaxHeight="112"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         Padding="11,8"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"
                                                         MaxLength="4000"
                                                         FontSize="13"
                                                         Style="{StaticResource FieldTextBoxStyle}" />

                                                <Grid Grid.Row="1"
                                                      Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button AutomationProperties.AutomationId="FollowUpAttachmentPickerButton"
                                                            AutomationProperties.Name="{Binding [FollowUp.AddAttachment], Source={StaticResource Loc}}"
                                                            Command="{Binding DataContext.RequestFollowUpAttachmentPickerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Width="34"
                                                            Height="34"
                                                            MinHeight="34"
                                                            ToolTipService.ShowOnDisabled="True">
                                                        <Button.Style>
                                                            <Style TargetType="Button"
                                                                   BasedOn="{StaticResource CompactIconButtonStyle}">
                                                                <Setter Property="ToolTip"
                                                                        Value="{Binding [FollowUp.AddAttachment], Source={StaticResource Loc}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAttachmentImportAvailable, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Value="False">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                        <Setter Property="ToolTip"
                                                                                Value="{Binding [FollowUp.AttachmentImportUnavailableInPreview], Source={StaticResource Loc}}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsAttachmentImportInProgress, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                 Value="True">
                                                                        <Setter Property="IsEnabled" Value="False" />
                                                                        <Setter Property="ToolTip"
                                                                                Value="{Binding [FollowUp.AttachmentImportInProgress], Source={StaticResource Loc}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <TextBlock Text="&#xE723;"
                                                                   FontFamily="{StaticResource IconFont}"
                                                                   FontSize="14" />
                                                    </Button>

                                                    <ScrollViewer Grid.Column="1"
                                                                  Margin="8,0"
                                                                  AutomationProperties.AutomationId="FollowUpAttachmentScrollViewer"
                                                                  HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Disabled"
                                                                  CanContentScroll="False">
                                                        <ItemsControl AutomationProperties.AutomationId="FollowUpAttachmentRail"
                                                                      ItemsSource="{Binding Attachments}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Width="228" Height="46">
                                                                        <Border x:Name="AttachmentDropBefore"
                                                                                Width="4"
                                                                                Height="32"
                                                                                Margin="-2,0,0,0"
                                                                                HorizontalAlignment="Left"
                                                                                VerticalAlignment="Center"
                                                                                Panel.ZIndex="2"
                                                                                Background="{DynamicResource PrimaryBrush}"
                                                                                CornerRadius="2"
                                                                                Opacity="0">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Opacity" Value="0" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ShowDropBefore}" Value="True">
                                                                                            <Setter Property="Opacity" Value="1" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                        </Border>
                                                                        <Border x:Name="AttachmentDropAfter"
                                                                                Width="4"
                                                                                Height="32"
                                                                                Margin="0,0,6,0"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Center"
                                                                                Panel.ZIndex="2"
                                                                                Background="{DynamicResource PrimaryBrush}"
                                                                                CornerRadius="2"
                                                                                Opacity="0">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Opacity" Value="0" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding ShowDropAfter}" Value="True">
                                                                                            <Setter Property="Opacity" Value="1" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
