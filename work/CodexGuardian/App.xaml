                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.16" />
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PeriodHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PeriodHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="PeriodRoot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.82"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PeriodRoot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.34"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="SelectionStates">
                                    <VisualState x:Name="Unselected" />
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PeriodSelection"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="ActiveStates">
                                    <VisualState x:Name="Active" />
                                    <VisualState x:Name="Inactive">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PeriodRoot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.42"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                    <VisualState x:Name="CalendarButtonUnfocused" />
                                    <VisualState x:Name="CalendarButtonFocused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PeriodFocusRing"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodexCalendarItemStyle" TargetType="CalendarItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CalendarItem">
                        <Grid x:Name="PART_Root"
                              MinWidth="252"
                              Background="{TemplateBinding Background}"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0"
                                  Margin="6,6,6,4"
                                  KeyboardNavigation.TabIndex="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_PreviousButton"
                                        Grid.Column="0"
                                        Style="{StaticResource CodexCalendarNavigationButtonStyle}">
                                    <Path Width="6"
                                          Height="10"
                                          Data="M 6,0 L 1,5 L 6,10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5"
                                          Stretch="Fill" />
                                </Button>
                                <Button x:Name="PART_HeaderButton"
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CodexCalendarHeaderButtonStyle}" />
                                <Button x:Name="PART_NextButton"
                                        Grid.Column="2"
                                        Style="{StaticResource CodexCalendarNavigationButtonStyle}">
                                    <Path Width="6"
                                          Height="10"
                                          Data="M 0,0 L 5,5 L 0,10"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeThickness="1.5"
                                          Stretch="Fill" />
                                </Button>
                            </Grid>
                            <Border Grid.Row="0"
                                    Margin="8,40,8,0"
                                    VerticalAlignment="Bottom"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0,0,0,1" />
                            <Grid x:Name="PART_MonthView"
                                  Grid.Row="1"
                                  Margin="7,4,7,8"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  KeyboardNavigation.TabNavigation="Once"
                                  KeyboardNavigation.TabIndex="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                            </Grid>
                            <Grid x:Name="PART_YearView"
                                  Grid.Row="1"
                                  Margin="8,6,8,10"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  KeyboardNavigation.TabNavigation="Once"
                                  KeyboardNavigation.TabIndex="1"
                                  Visibility="Hidden">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                            </Grid>
                            <Border x:Name="PART_DisabledVisual"
                                    Grid.RowSpan="2"
                                    Background="{DynamicResource DisabledSurfaceBrush}"
                                    CornerRadius="6"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PART_DisabledVisual" Property="Opacity" Value="0.32" />
                                <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}"
                                         Value="Year">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}"
                                         Value="Decade">
                                <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                                <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                        <ControlTemplate.Resources>
                            <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                                <TextBlock Margin="2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource BodyFont}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkSubtleBrush}"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ControlTemplate.Resources>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodexCalendarStyle" TargetType="Calendar">
            <Setter Property="CalendarButtonStyle" Value="{StaticResource CodexCalendarButtonStyle}" />
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CodexCalendarDayButtonStyle}" />
            <Setter Property="CalendarItemStyle" Value="{StaticResource CodexCalendarItemStyle}" />
            <Setter Property="Background" Value="{DynamicResource GlassSurfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Calendar">
                        <Border x:Name="PART_Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <CalendarItem x:Name="PART_CalendarItem"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          Background="Transparent"
                                          BorderBrush="Transparent"
                                          BorderThickness="0"
                                          Style="{TemplateBinding CalendarItemStyle}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CodexDatePickerCalendarStyle"
               TargetType="Calendar"
               BasedOn="{StaticResource CodexCalendarStyle}">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18"
                                      Direction="270"
                                      Opacity="0.28"
                                      ShadowDepth="6"
                                      Color="#FF000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Calendar" BasedOn="{StaticResource CodexCalendarStyle}" />

        <Style TargetType="DatePicker">
            <Setter Property="CalendarStyle" Value="{StaticResource CodexDatePickerCalendarStyle}" />
            <Setter Property="Background" Value="{DynamicResource FieldSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CodexFocusVisual}" />
            <Setter Property="IsTodayHighlighted" Value="True" />
            <Setter Property="SelectedDateFormat" Value="Short" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Grid x:Name="DatePickerRoot">
                            <Border x:Name="FieldBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <Grid x:Name="PART_Root">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="34" />
                                    </Grid.ColumnDefinitions>
                                    <DatePickerTextBox x:Name="PART_TextBox"
                                                       Grid.Column="0"
                                                       Background="Transparent"
                                                       Foreground="{TemplateBinding Foreground}"
                                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                        HorizontalContentAlignment="Stretch"
                                                        VerticalContentAlignment="Center"
                                                       KeyboardNavigation.TabIndex="0" />
                                    <Button x:Name="PART_Button"
                                            Grid.Column="1"
                                            Margin="2"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderBrush="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Focusable="False"
                                            IsTabStop="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CalendarButtonSurface"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource InkMutedBrush}"
                                                               Text="&#xE787;" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CalendarButtonSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="CalendarButtonSurface" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=PART_Root}"
                                   PopupAnimation="Fade"
                                   StaysOpen="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource InkMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="PART_Button" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                            </Trigger>
                            <Trigger Property="Validation.HasError" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}" />
                                <Setter TargetName="PART_Button" Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToggleCheckStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CodexFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="ToggleRoot"
                              Width="38"
                              Height="22"
                              RenderTransformOrigin="0.5,0.5">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition From="Unchecked"
                                                          To="Checked"
                                                          GeneratedDuration="0:0:0.16">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                        <VisualTransition From="Checked"
                                                          To="Unchecked"
                                                          GeneratedDuration="0:0:0.16">
                                            <VisualTransition.GeneratedEasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </VisualTransition.GeneratedEasingFunction>
                                        </VisualTransition>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="0"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="16"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X"
                                                             To="8"
                                                             Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="TrackOn"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.5"
                                                             Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ToggleScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="Track"
                                    Background="{DynamicResource BorderStrongBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11" />
                            <!-- The lit track is its own layer so the colour can cross-fade over the
                                 same 220ms the thumb takes to travel. A Setter on Track.Background
                                 swaps the brush reference in a single frame, and a ColorAnimation
                                 cannot target a DynamicResource, so neither one carries a transition
                                 here - the thumb would glide while the track snapped. -->
                            <Border x:Name="TrackOn"
                                    Background="{DynamicResource PrimaryBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Margin="3,0,0,0"
                                     HorizontalAlignment="Left"
                                     Fill="{DynamicResource ToggleThumbBrush}">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbTransform" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource InkMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.96"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ToggleScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.96"
                                                             Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.24" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ToggleScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.24" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- Dim the whole toggle, not Track and Thumb individually: the lit
                                     TrackOn layer is driven by an animation, and an animated property
                                     outranks any Setter aimed at it. -->
                                <Setter TargetName="ToggleRoot" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A master switch that lives in the title bar: icon plus label, quiet when off and lit
             when on. Tag carries the glyph, so one call site supplies both halves inline without a
             nested panel. The lit state is carried by colour on all three of border, glyph and label
             because a title bar has no room for a caption explaining what the control does. -->
        <Style x:Key="TitleBarSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CodexFocusVisual}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="SwitchCanvas" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="SwitchScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="SwitchRoot"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True" />
                            <!-- The lit fill and outline get their own layer for the same reason the
                                 toggle track does: Setters swap brush references in one frame, so the
                                 glyph would bounce for 340ms next to a border that had already
                                 finished changing colour. Below the hover layer, so hovering still
                                 lightens the switch once it is on. -->
                            <Border x:Name="SwitchLit"
                                    Background="{DynamicResource GreenSoftBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="5"
                                    IsHitTestVisible="False"
                                    Opacity="0"
                                    SnapsToDevicePixels="True" />
                            <!-- Hover lives on its own layer so it reads the same whether the switch is
                                 on or off. Folding hover into the root's own brush meant the lit state
                                 overwrote it, and a master switch that stops responding to the pointer
                                 once enabled feels broken. -->
                            <Border x:Name="SwitchHover"
                                    Background="{DynamicResource GlassHighlightBrush}"
                                    CornerRadius="5"
                                    Opacity="0"
                                    IsHitTestVisible="False" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock x:Name="SwitchGlyph"
                                           Text="{TemplateBinding Tag}"
                                           Margin="0,0,7,0"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="13"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform x:Name="SwitchGlyphScale" ScaleX="1" ScaleY="1" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.13" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95"
                                                             Duration="0:0:0.11" />
                                            <DoubleAnimation Storyboard.TargetName="SwitchScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95"
                                                             Duration="0:0:0.11" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- Last, so the lit foreground wins over the hover foreground above. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource GreenBrush}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchLit"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchGlyphScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.82"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.32" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SwitchGlyphScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.82"
                                                             To="1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.32" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SwitchLit"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <!-- The whole switch, not just SwitchRoot: SwitchLit's opacity is
                                     animation-driven and would stay fully lit otherwise. -->
                                <Setter TargetName="SwitchCanvas" Property="Opacity" Value="0.45" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One segment of an inline three-way choice. Deliberately not a ComboBox: the three states
             are worth seeing at a glance, and a popup over a list that refreshes on every monitor pass
             loses the user's half-made selection when the row underneath it moves. -->
        <Style x:Key="SegmentedChoiceStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CodexFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="SegmentHover"
                                    Background="{DynamicResource GlassHighlightBrush}"
                                    CornerRadius="6"
                                    Opacity="0" />
                            <!-- Named so the selection fade has a mutable target. An unnamed brush or
                                 transform inside a template gets frozen, and animating it throws. -->
                            <Border x:Name="SegmentFill"
                                    Background="{DynamicResource PrimarySoftBrush}"
                                    BorderBrush="{DynamicResource PrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SegmentHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SegmentHover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.16" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SegmentFill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.17" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SegmentFill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.17" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConversationDragGripButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="44" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
            <!-- A grip is a move affordance, not a vertical resize handle.  The cursor
                 changes to SizeAll only after the drag threshold is crossed. -->
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="GripScale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="GripSurface"
                                    Width="26"
                                    Height="36"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" />
                            <UniformGrid Width="9"
                                         Height="16"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Rows="3"
                                         Columns="2">
                                <Ellipse Width="2.5" Height="2.5" Margin="1" Fill="{TemplateBinding Foreground}" />
                                <Ellipse Width="2.5" Height="2.5" Margin="1" Fill="{TemplateBinding Foreground}" />
                                <Ellipse Width="2.5" Height="2.5" Margin="1" Fill="{TemplateBinding Foreground}" />
                                <Ellipse Width="2.5" Height="2.5" Margin="1" Fill="{TemplateBinding Foreground}" />
                                <Ellipse Width="2.5" Height="2.5" Margin="1" Fill="{TemplateBinding Foreground}" />
                                <Ellipse Width="2.5" Height="2.5" Margin="1" Fill="{TemplateBinding Foreground}" />
                            </UniformGrid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GripSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter TargetName="GripSurface" Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="GripSurface" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                                <Setter TargetName="GripSurface" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GripScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.9"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GripScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.9"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GripScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.28" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="GripScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.28" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GripSurface" Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConversationListItemStyle" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="ContainerRoot"
                              ClipToBounds="False"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="RowScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="RowLift" Y="0" />
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="StatusAura"
                                    Margin="0"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="0"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                            <controls:GlassSurface x:Name="RowSurface"
                                    Background="{DynamicResource ConversationSurfaceBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Elevation="7"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border x:Name="StatusSpine"
                                            Width="3"
                                            Margin="0,9,0,9"
                                            HorizontalAlignment="Left"
                                            Background="Transparent"
                                            CornerRadius="1.5"
                                            IsHitTestVisible="False" />
                                    <Border x:Name="StatusWash"
                                            Background="Transparent"
                                            CornerRadius="16"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                    <Border x:Name="HoverVeil"
                                            Background="{DynamicResource ConversationHoverBrush}"
                                            CornerRadius="16"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                    <Border x:Name="SelectVeil"
                                            Background="{DynamicResource ConversationSelectedBrush}"
                                            CornerRadius="16"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                    <Border x:Name="FocusRing"
                                            Margin="2"
                                            BorderBrush="{DynamicResource PrimaryBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14"
                                            IsHitTestVisible="False"
                                            Opacity="0" />
                                    <ContentPresenter x:Name="RowContent"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Grid>
                            </controls:GlassSurface>
                            <Border x:Name="DropBeforeIndicator"
                                    Height="4"
                                    Margin="18,-7,18,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="2"
                                    Panel.ZIndex="4"
                                    Visibility="Collapsed" />
                            <Border x:Name="DropAfterIndicator"
                                    Height="4"
                                    Margin="18,0,18,-7"
                                    VerticalAlignment="Bottom"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="2"
                                    Panel.ZIndex="4"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding VisualTone}" Value="{x:Static models:TaskVisualTone.Healthy}">
                                <Setter TargetName="StatusAura" Property="BorderBrush" Value="{DynamicResource GreenBrush}" />
                                <Setter TargetName="StatusSpine" Property="Background" Value="{DynamicResource GreenBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VisualTone}" Value="{x:Static models:TaskVisualTone.Attention}">
                                <Setter TargetName="StatusAura" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="StatusSpine" Property="Background" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverVeil"
                                             Storyboard.TargetProperty="Opacity"
                                              To="0.08"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowLift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1"
                                                             Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="HoverVeil"
                                             Storyboard.TargetProperty="Opacity"
                                              To="0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowLift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectVeil" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseCaptureWithin" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.992"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.992"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RowScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1"
                                                             Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.2" EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                <Setter TargetName="RowContent" Property="Opacity" Value="0" />
                                <Setter TargetName="HoverVeil" Property="Opacity" Value="0" />
                                <Setter TargetName="SelectVeil" Property="Opacity" Value="0" />
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0" />
                                <Setter TargetName="StatusAura" Property="Opacity" Value="0" />
                                <Setter TargetName="StatusWash" Property="Opacity" Value="0" />
                                <Setter TargetName="RowSurface" Property="Background" Value="{DynamicResource ConversationPlaceholderBrush}" />
                                <Setter TargetName="RowSurface" Property="BorderBrush" Value="{DynamicResource PrimarySoftBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowDropBefore}" Value="True">
                                <Setter TargetName="DropBeforeIndicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShowDropAfter}" Value="True">
                                <Setter TargetName="DropAfterIndicator" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ContainerRoot" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatListItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CodexFocusVisual}" />
        </Style>

        <Style x:Key="ConversationNavigationItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource FlatListItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- The rounded conversation button owns hover; no system selection plate behind it. -->
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FollowUpListItemStyle"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource FlatListItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Message}" />
            <Setter Property="Margin" Value="0" />
            <!-- Keep ListBox selection semantics without the default WPF selection chrome. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NamedOptionComboBoxItemStyle"
               TargetType="ComboBoxItem"
               BasedOn="{StaticResource FieldComboBoxItemStyle}">
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
        </Style>

        <DataTemplate x:Key="NamedOptionTemplate">
            <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>

        <Style x:Key="SlimScrollThumbVerticalStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface"
                                Margin="5,2,2,2"
                                Background="{DynamicResource BorderStrongBrush}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource InkSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource InkMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollThumbHorizontalStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface"
                                Margin="2,5,2,2"
                                Background="{DynamicResource BorderStrongBrush}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource InkSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource InkMutedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track"
                                           IsDirectionReversed="True">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimScrollThumbVerticalStyle}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimScrollThumbHorizontalStyle}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
