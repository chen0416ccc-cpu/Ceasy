<Page x:Class="CodexGuardian.Views.UserGuidePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      UseLayoutRounding="True"
      SnapsToDevicePixels="True"
      Loaded="UserGuidePage_Loaded"
      AutomationProperties.Name="{Binding [Guide.Title], Source={StaticResource Loc}}">
    <Page.Resources>
        <Style x:Key="GuideBodyStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="GuideSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="Margin" Value="0,0,20,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="GuideSectionStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="0,20,0,20" />
        </Style>
    </Page.Resources>
    <Grid Margin="20,0,20,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="UserGuideBackButton"
                    Width="34"
                    Height="34"
                    Margin="0,0,12,0"
                    Style="{StaticResource IconButtonStyle}"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Settings"
                    AutomationProperties.AutomationId="UserGuideBackButton"
                    AutomationProperties.Name="{Binding [Guide.Back], Source={StaticResource Loc}}"
                    ToolTip="{Binding [Guide.Back], Source={StaticResource Loc}}">
                <TextBlock Text="&#xE72B;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="14"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <TextBlock Grid.Column="1"
                       Text="{Binding [Guide.Title], Source={StaticResource Loc}}"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkBrush}"
                       VerticalAlignment="Center" />
        </Grid>
        <ScrollViewer Grid.Row="1"
                      AutomationProperties.AutomationId="UserGuideScrollViewer"
                      AutomationProperties.Name="{Binding [Guide.Title], Source={StaticResource Loc}}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,16,24">
            <StackPanel MaxWidth="840" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding [Guide.IntroBody], Source={StaticResource Loc}}"
                           Style="{StaticResource GuideBodyStyle}"
                           Margin="0,2,0,20" />
                <Border Style="{StaticResource GuideSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Guide.PrinciplesTitle], Source={StaticResource Loc}}"
                                   Style="{StaticResource GuideSectionHeaderStyle}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Guide.MonitoringBody], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}" />
                            <TextBlock Text="{Binding [Guide.DefaultBody], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding [Guide.AuthorizationBody], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource GuideSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Guide.NavigationTitle], Source={StaticResource Loc}}"
                                   Style="{StaticResource GuideSectionHeaderStyle}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Guide.NavigationConversations], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}" />
                            <TextBlock Text="{Binding [Guide.NavigationActivity], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding [Guide.NavigationGuardrails], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding [Guide.NavigationKeepAlive], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding [Guide.NavigationPreferences], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource GuideSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Guide.PresetTitle], Source={StaticResource Loc}}"
                                   Style="{StaticResource GuideSectionHeaderStyle}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Guide.PresetBody], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}" />
                            <TextBlock Text="{Binding [Guide.PresetAuthorization], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource GuideSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Guide.RecoveryTitle], Source={StaticResource Loc}}"
                                   Style="{StaticResource GuideSectionHeaderStyle}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Guide.RecoveryEligible], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}" />
                            <TextBlock Text="{Binding [Guide.RecoveryBlocked], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding [Guide.RecoveryEvidence], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource GuideSectionStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Guide.KeepAliveTitle], Source={StaticResource Loc}}"
                                   Style="{StaticResource GuideSectionHeaderStyle}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding [Guide.KeepAliveBody], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}" />
                            <TextBlock Text="{Binding [Guide.KeepAliveAuthorization], Source={StaticResource Loc}}"
                                       Style="{StaticResource GuideBodyStyle}"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource GuideSectionStyle}" Padding="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="152" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding [Guide.TrayTitle], Source={StaticResource Loc}}"
                                   Style="{StaticResource GuideSectionHeaderStyle}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding [Guide.TrayBody], Source={StaticResource Loc}}"
                                   Style="{StaticResource GuideBodyStyle}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
