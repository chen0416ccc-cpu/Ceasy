<Application x:Class="CodexGuardian.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CodexGuardian.Controls"
             xmlns:loc="clr-namespace:CodexGuardian.Localization"
             xmlns:models="clr-namespace:CodexGuardian.Models"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <loc:LocalizationService x:Key="Loc" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Native backdrop, translucent surfaces, and reflection remain separate material layers. -->
        <SolidColorBrush x:Key="CanvasBrush" Color="#FF102330" />
        <SolidColorBrush x:Key="WindowBackdropBrush" Color="#C40B1C29" />
        <SolidColorBrush x:Key="GlassReflectionBrush" Color="#32FFFFFF" />
        <SolidColorBrush x:Key="AmbientCoolBrush" Color="#806EADE1" />
        <SolidColorBrush x:Key="AmbientWarmBrush" Color="#6069C3B0" />
        <SolidColorBrush x:Key="PaperBrush" Color="#B3203748" />
        <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#553E596C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#284E7A96" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#6086A9BC" />
        <SolidColorBrush x:Key="GlassSurfaceBrush" Color="#88253C4C" />
        <SolidColorBrush x:Key="GlassSurfaceStrongBrush" Color="#D0203544" />
        <SolidColorBrush x:Key="GlassBorderBrush" Color="#508DB1C6" />
        <SolidColorBrush x:Key="GlassHighlightBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="AmbientGlowBrush" Color="#60799DC7" />
        <SolidColorBrush x:Key="WindowEdgeBrush" Color="#6684A7BC" />
        <SolidColorBrush x:Key="ConversationSurfaceBrush" Color="#8A385366" />
        <SolidColorBrush x:Key="ConversationHoverBrush" Color="#B4486C83" />
        <SolidColorBrush x:Key="ConversationSelectedBrush" Color="#A5447186" />
        <SolidColorBrush x:Key="ConversationPlaceholderBrush" Color="#50304B5C" />
        <SolidColorBrush x:Key="FloatingShadowBrush" Color="#66000000" />
        <SolidColorBrush x:Key="ControlSurfaceBrush" Color="#80354E60" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#B84B7088" />
        <SolidColorBrush x:Key="FieldSurfaceBrush" Color="#66132430" />
        <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#FF27272A" />
        <SolidColorBrush x:Key="DisabledBorderBrush" Color="#FF3F3F46" />
        <SolidColorBrush x:Key="DisabledInkBrush" Color="#FF71717A" />
        <SolidColorBrush x:Key="InkBrush" Color="#FFFAFAFA" />
        <SolidColorBrush x:Key="InkDimBrush" Color="#FFD4D4D8" />
        <SolidColorBrush x:Key="InkMutedBrush" Color="#FFA1A1AA" />
        <SolidColorBrush x:Key="InkSubtleBrush" Color="#FF71717A" />
        <SolidColorBrush x:Key="ToggleThumbBrush" Color="#FFFAFAFA" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF8DB2F6" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FFA9C4FF" />
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#332E5E9E" />
        <SolidColorBrush x:Key="SignatureBrush" Color="#FF8DB2F6" />
        <SolidColorBrush x:Key="SignatureSoftBrush" Color="#332E5E9E" />
        <SolidColorBrush x:Key="GreenBrush" Color="#7BD98C" />
        <SolidColorBrush x:Key="GreenSoftBrush" Color="#B31B3D24" />
        <SolidColorBrush x:Key="OrangeBrush" Color="#FDB674" />
        <SolidColorBrush x:Key="OrangeSoftBrush" Color="#B34A3016" />
        <SolidColorBrush x:Key="YellowBrush" Color="#F0CE7E" />
        <SolidColorBrush x:Key="YellowSoftBrush" Color="#B3453A1C" />
        <SolidColorBrush x:Key="BlueBrush" Color="#FF8DB2F6" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#332E5E9E" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF8192" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#B346242E" />

        <DropShadowEffect x:Key="ConversationShadowEffect"
                          BlurRadius="10"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.16"
                          Color="#000000" />

        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style TargetType="{x:Type controls:GlassSurface}">
            <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="ReflectionBrush" Value="{DynamicResource GlassReflectionBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="CodexFocusVisual" TargetType="{x:Type Control}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="1"
                                BorderBrush="{DynamicResource PrimaryBrush}"
                                BorderThickness="2"
                                CornerRadius="6" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
            <Setter Property="TextOptions.TextHintingMode" Value="Auto" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource GlassSurfaceStrongBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <!-- The default template is a square-cornered border that appears in one
                             frame. Seventy-odd call sites use tooltips, so this is the most-seen
                             transient surface in the app and the only one that was still popping. -->
                        <Border x:Name="TipRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <!-- Growing to full size means every intermediate frame is smaller
                                     than the Popup that hosts it, so nothing is ever clipped. A
                                     translation would push the top edge outside and shear it. -->
                                <ScaleTransform x:Name="TipScale" ScaleX="0.96" ScaleY="0.96" />
                            </Border.RenderTransform>
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsOpen" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- From is explicit because a tooltip instance is cached
                                                 on its owner and reopened: without it the second
                                                 hover would animate from the held value of 1 to 1. -->
                                            <DoubleAnimation Storyboard.TargetName="TipRoot"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TipScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             From="0.96"
                                                             To="1"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TipScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             From="0.96"
                                                             To="1"
                                                             Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CodexFocusVisual}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <!-- Compress immediately; spring only the transform on release. -->
                                            <VisualTransition To="Pressed"
                                                              GeneratedDuration="0:0:0.07">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                            <VisualTransition From="Pressed"
                                                              GeneratedDuration="0:0:0.36">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.36">
                                                        <DoubleAnimation.EasingFunction><controls:SpringEase /></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.36">
                                                        <DoubleAnimation.EasingFunction><controls:SpringEase /></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition GeneratedDuration="0:0:0.11">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateVeil"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.06"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateVeil"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.12"
                                                                 Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.94"
                                                                 Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.94"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="StateVeil"
                                        Background="{DynamicResource InkBrush}"
                                        CornerRadius="6"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                   RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}" />
                    <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PaperBrush}" />
            <Setter Property="Background" Value="{DynamicResource InkBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InkDimBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource InkDimBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}" />
                    <Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />

        <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quiet actions share the workbench rhythm without adding a filled button to every row. -->
        <Style x:Key="WorkspaceQuietButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="QuietRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="QuietRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="QuietRoot" Property="Background" Value="{DynamicResource PrimarySoftBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="QuietRoot" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                <Setter TargetName="QuietRoot" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="QuietRoot" Property="Opacity" Value="0.48" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The brand mark already carries its own hover animation and a filled logo, so the usual button
             surface would read as a second control stacked behind it. This template keeps what a button is
             for — a click target, a keyboard stop, a focus ring — and draws nothing else. -->
        <Style x:Key="BrandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CodexFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Transparent rather than unset: a null Background is not hit-testable, which would
                             shrink the click target to the logo's own opaque pixels. -->
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConversationButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <controls:GlassSurface x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16"
                                Elevation="7"
                                RenderTransformOrigin="0.5,0.5"
                                SnapsToDevicePixels="True">
                            <controls:GlassSurface.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="ButtonLift" Y="0" />
                                </TransformGroup>
                            </controls:GlassSurface.RenderTransform>
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualStateGroup.Transitions>
                                            <VisualTransition To="Pressed" GeneratedDuration="0:0:0.07">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                            <VisualTransition From="Pressed" GeneratedDuration="0:0:0.38">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.38">
                                                        <DoubleAnimation.EasingFunction><controls:SpringEase /></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.38">
                                                        <DoubleAnimation.EasingFunction><controls:SpringEase /></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </VisualTransition>
                                            <VisualTransition GeneratedDuration="0:0:0.11">
                                                <VisualTransition.GeneratedEasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </VisualTransition.GeneratedEasingFunction>
                                            </VisualTransition>
                                        </VisualStateGroup.Transitions>
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="MouseOver">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateVeil"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.06"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="StateVeil"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.12"
                                                                 Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleX"
                                                                 To="0.985"
                                                                 Duration="0" />
                                                <DoubleAnimation Storyboard.TargetName="ButtonScale"
                                                                 Storyboard.TargetProperty="ScaleY"
                                                                 To="0.965"
                                                                 Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="StateVeil"
                                        Background="{DynamicResource InkBrush}"
                                        CornerRadius="16"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                                <!-- Hover accent is a separate 1px ring animated through Opacity, not a
                                     ColorAnimation on the row border. Two reasons: the outer border carries
                                     run/retry status colour and must stay readable, and a ColorAnimation
                                     cannot take a DynamicResource target, so it would hard-code one
                                     theme's primary colour. -->
                                <Border x:Name="HoverOutline"
                                        BorderBrush="{DynamicResource PrimaryBrush}"
                                        BorderThickness="1"
                                CornerRadius="16"
                                        IsHitTestVisible="False"
                                        Opacity="0" />
                            </Grid>
                        </controls:GlassSurface>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonLift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-4"
                                                             Duration="0:0:0.38">
                                                <DoubleAnimation.EasingFunction>
                                                    <controls:SpringEase />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverOutline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1"
                                                             Duration="0:0:0.11">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonLift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0"
                                                             Duration="0:0:0.42">
                                                <DoubleAnimation.EasingFunction>
                                                    <controls:SpringEase />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="HoverOutline"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="CompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <!-- Rotation lives in ActivitySpinner rather than in this template: a storyboard started from a
             trigger here would freeze whenever a virtualized row is recycled. -->
        <Style TargetType="{x:Type controls:ActivitySpinner}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource YellowBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:ActivitySpinner}">
                        <Grid>
                            <Ellipse Margin="1"
                                     Stroke="{TemplateBinding Foreground}"
                                     StrokeThickness="1.6"
                                     Opacity="{TemplateBinding TrackOpacity}" />
                            <Path Stretch="None"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M 6.5,1 A 5.5,5.5 0 1 1 1,6.5" />
                        </Grid>
